---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Unstitch — One tile. Endless possibilities.">
  <main>
    <!-- ============ HERO ============ -->
    <section class="wrap hero">
      <div class="hero__copy">
        <p class="hero__eyebrow">Interlocking Textile Module System</p>
        <h1 class="hero__title">One tile.<br />Endless possibilities.</h1>
        <p class="hero__body">
          Imagine building 3D textile creations without needing to sew or stitch.
        </p>
        <div class="hero__ctas">
          <a href="/playground" class="btn btn-filled">Explore the Playground</a>
          <a href="/shop" class="btn btn-outline">Join the Next Drop</a>
        </div>
      </div>
      <div class="hero__media">
        <div class="ph hero__ph" style="aspect-ratio: 1 / 1;">
          <img src="/OneTileGif.gif" alt="One tile, endless possibilities — modular textile animation" class="w-full h-full object-contain p-4" onerror="this.style.display='none'" />
        </div>
      </div>
    </section>

    <div class="stitch" aria-hidden="true"></div>

    <!--
    ============ LATEST DROP — HIDDEN FOR NOW ============
    Commented out rather than deleted so it's easy to bring back once
    there's an actual live drop to show. Replaced below by a countdown
    to the next release instead.
    <section class="wrap section">
      <h2 class="section__title">Latest Drop</h2>
      <div class="product-grid">
        <article class="product-card">
          <div class="ph" style="aspect-ratio: 1 / 1;">
            <img src="/Tote.png" alt="Tote Collection" class="w-full h-full object-contain p-4" onerror="this.style.display='none'" />
          </div>
          <h3 class="product-card__name">Modular Tote</h3>
          <p class="product-card__price">$0.00</p>
          <a href="/shop" class="btn btn-outline btn-small product-card__cta">Explore Collection</a>
        </article>

        <article class="product-card">
          <div class="ph" style="aspect-ratio: 1 / 1;">
            <img src="/BucketFlip.png" alt="Bucket Bag Collection" class="w-full h-full object-contain p-4" onerror="this.style.display='none'" />
          </div>
          <h3 class="product-card__name">Bucket Bag</h3>
          <p class="product-card__price">$0.00</p>
          <a href="/shop" class="btn btn-outline btn-small product-card__cta">Explore Collection</a>
        </article>

        <article class="product-card">
          <div class="ph" style="aspect-ratio: 1 / 1;">
            <img src="/Clutch.png" alt="Clutch Collection" class="w-full h-full object-contain p-4" onerror="this.style.display='none'" />
          </div>
          <h3 class="product-card__name">Origami Clutch</h3>
          <p class="product-card__price">$0.00</p>
          <a href="/shop" class="btn btn-outline btn-small product-card__cta">Explore Collection</a>
        </article>
      </div>
    </section>
    -->

    <!-- ============ NEXT DROP COUNTDOWN ============
         EDITABLE: data-target is the release moment (Melbourne time,
         AEST = +10:00 outside daylight saving, AEDT = +11:00 from
         October). Update this same value if the date changes. -->
    <section class="wrap section home-countdown-section">
      <p class="section__eyebrow">Next Drop</p>
      <h2 class="section__title">Releases Monday, 8:00am</h2>
      <div class="countdown countdown--home" data-countdown data-target="2026-09-14T08:00:00+10:00" aria-label="Time remaining until the next drop">
        <div class="countdown__unit">
          <span class="countdown__digits" data-cd-days>00</span>
          <span class="countdown__label">Days</span>
        </div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit">
          <span class="countdown__digits" data-cd-hours>00</span>
          <span class="countdown__label">Hours</span>
        </div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit">
          <span class="countdown__digits" data-cd-mins>00</span>
          <span class="countdown__label">Minutes</span>
        </div>
        <span class="countdown__sep">:</span>
        <div class="countdown__unit">
          <span class="countdown__digits" data-cd-secs>00</span>
          <span class="countdown__label">Seconds</span>
        </div>
      </div>
      <a href="/shop" class="btn btn-outline btn-small home-countdown-section__cta">See Drop Details</a>
    </section>

    <div class="stitch" aria-hidden="true"></div>

    <!-- ============ WORKSHOP CALLOUT ============
         Full-bleed tinted band (Zero Waste Victoria's brand colour at
         ~35% opacity), content still constrained to the normal width. -->
    <section class="workshop">
      <div class="wrap workshop__inner">
        <div class="workshop__copy">
          <p class="section__eyebrow">Up Next — Public Experience Workshop</p>
          <h2 class="workshop__title">Find us at Zero Waste Festival.<br />Saturday 12 Sep 2026.<br />Fed Square.</h2>
          <p class="workshop__body">Drop-in tile building all day 12pm–6pm, no experience needed. Visit to try out our newly launched virtual playground and go in the raffle draw to win 1 Unstitch's latest drop.</p>
          <a href="https://zerowastevictoria.org.au/zero-waste-festival/activities/" target="_blank" rel="noopener" class="btn btn-outline workshop__cta">Learn More</a>
        </div>
      </div>
    </section>

    <div class="stitch" aria-hidden="true"></div>

    <!-- ============ ABOUT BLURB — EDITABLE ============ -->
    <section class="wrap about-blurb">
      <h2 class="about-blurb__title">We're a Melbourne-based circular design studio.</h2>
      <p class="about-blurb__body">We design zero-waste, interlocking tiles from upcycled textile, each piece crafted with precision. From our own collections to bespoke commissions, we partner with schools and clients to turn ideas into reality.</p>
    </section>

    <!-- ============ LEARN / CUSTOM / SHOP NAV TILES ============ -->
    <section class="explore-grid">
      <a class="explore-tile">
        <div class="explore-tile__media">
          <img src="/assets/home/learn-workshop-setup.webp" alt="Workshop table set up with modular felt tiles ready for a session" width="446" height="335" loading="lazy" />
        </div>
        <span class="explore-tile__label">Learn</span>
      </a>
      <a class="explore-tile">
        <div class="explore-tile__media">
          <img src="/assets/home/custom-owl.webp" alt="Custom interlocking tile owl installation on a wall" width="446" height="335" loading="lazy" />
        </div>
        <span class="explore-tile__label">Custom</span>
      </a>
      <!-- <a href="/shop" class="explore-tile">-->
      <a class="explore-tile">
        <div class="explore-tile__media">
          <img src="/assets/home/shop-tote.webp" alt="Modular felt tote bag made from interlocking Unstitch tiles" width="542" height="542" loading="lazy" />
        </div>
        <span class="explore-tile__label">Shop</span>
      </a>
    </section>

    <!-- ============ EMAIL SIGNUP ============ -->
    <section class="wrap signup">
      <p class="signup__text">Every tile keeps something out of the landfill. Join the movement.</p>
      <form class="signup__form" data-subscribe-form="home-signup">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none !important;" aria-hidden="true" />
        <label class="sr-only" for="signup-name">Your name</label>
        <input id="signup-name" class="signup__input" type="text" placeholder="Name" autocomplete="name" />
        <label class="sr-only" for="signup-email">Your email</label>
        <input id="signup-email" class="signup__input" type="email" placeholder="Your Email" required />
        <button type="submit" class="btn btn-filled">Join</button>
      </form>
    </section>
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 64px;
  }
  .hero__eyebrow {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 14px;
  }
  .hero__title {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    margin-bottom: 18px;
  }
  .hero__body {
    font-size: 1.02rem;
    color: #333;
    max-width: 42ch;
    margin-bottom: 28px;
  }
  .hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero__ph {
    border-radius: var(--radius);
    background: #fafafa;
    border: 1.5px solid var(--ink);
    overflow: hidden;
  }

  .workshop__inner {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .workshop__title {
    font-size: clamp(1.5rem, 3.4vw, 2.2rem);
    margin: 6px 0 18px;
  }
  .workshop__body { max-width: 52ch; color: #333; margin-bottom: 24px; }
  .workshop__cta { display: inline-flex; background: rgba(109, 119, 26); color: white; }

  .home-countdown-section {
    padding-top: 56px;
    padding-bottom: 56px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .home-countdown-section .section__eyebrow { text-align: center; }
  .home-countdown-section .section__title { margin-bottom: 28px; }
  .countdown--home { margin-bottom: 28px; }
  .home-countdown-section__cta { margin-top: 4px; }

  .about-blurb { padding-top: 56px; padding-bottom: 32px; }
  .about-blurb__title {
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    margin-bottom: 14px;
  }
  .about-blurb__body { max-width: 60ch; color: #333; }

  .explore-grid {
    display: flex;
    justify-content: center;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .explore-grid .explore-tile {
    width: 100%;
    max-width: 380px;
  }
  .explore-tile {
    border-right: 1px solid var(--ink);
    padding: 0 0 20px;
    display: block;
    transition: background 0.2s ease;
  }
  .explore-tile:hover {
    background: #faf8f9;
  }
  .explore-tile:last-child { border-right: none; }
  .explore-tile__media {
    aspect-ratio: 4 / 3;
    border: none;
    border-radius: 0;
    background: #fcfcfc;
    overflow: hidden;
  }
  .explore-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* The Shop tile's photo is a square product shot on a plain
     background, not an environmental photo — contain (not cover) keeps
     the whole bag visible instead of cropping it to fit the 4:3 frame. */
  .explore-tile:last-child .explore-tile__media img {
    object-fit: contain;
    padding: 12px;
  }
  .explore-tile__label {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-top: 18px;
  }

  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; padding-top: 32px; padding-bottom: 44px; }
    .hero__media { order: -1; }
    .explore-tile { border-right: none; border-bottom: 1px solid var(--ink); padding-bottom: 24px; }
    .explore-tile:last-child { border-bottom: none; }
  }
</style>

<script>
  function initCountdown() {
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
      const targetStr = el.dataset.target || '';
      const target = new Date(targetStr).getTime();
      const daysEl = el.querySelector<HTMLElement>('[data-cd-days]');
      const hoursEl = el.querySelector<HTMLElement>('[data-cd-hours]');
      const minsEl = el.querySelector<HTMLElement>('[data-cd-mins]');
      const secsEl = el.querySelector<HTMLElement>('[data-cd-secs]');
      const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

      const tick = () => {
        const diff = target - Date.now();
        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '00';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
          el.classList.add('is-complete');
          clearInterval(timer);
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        if (daysEl) daysEl.textContent = pad(Math.floor(totalSeconds / 86400));
        if (hoursEl) hoursEl.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
        if (minsEl) minsEl.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
        if (secsEl) secsEl.textContent = pad(totalSeconds % 60);
      };

      tick();
      const timer = setInterval(tick, 1000);
    });
  }

  function initForms() {
    document.querySelectorAll<HTMLFormElement>('[data-subscribe-form]').forEach((form) => {
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalLabel = submitBtn ? submitBtn.textContent : '';

      let feedback = form.nextElementSibling as HTMLElement;
      if (!feedback || !feedback.classList.contains('form-feedback')) {
        feedback = document.createElement('p');
        feedback.className = 'form-feedback';
        feedback.setAttribute('role', 'status');
        form.insertAdjacentElement('afterend', feedback);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = form.querySelector<HTMLInputElement>('input[type="text"]:not([name="_gotcha"])');
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const gotchaInput = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const _gotcha = gotchaInput ? gotchaInput.value : '';

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        feedback.textContent = '';
        feedback.className = 'form-feedback';

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, source: form.dataset.subscribeForm || undefined, _gotcha }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || (res.status === 429 ? 'Too many requests. Please wait a moment.' : 'Something went wrong.'));

          form.reset();
          feedback.textContent = "You're on the list.";
          feedback.classList.add('form-feedback--success');
        } catch (err: any) {
          feedback.textContent = err.message || 'Something went wrong. Please try again.';
          feedback.classList.add('form-feedback--error');
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
        }
      });
    });
  }

  initCountdown();
  initForms();
  document.addEventListener('astro:page-load', () => {
    initCountdown();
    initForms();
  });
</script>
