<script>
  import { esc } from "../../lib/emailTemplate.js";

  type OrderSummary = {
    id: string;
    orderNumber: string;
    status: string;
    totalCents: number;
    currency: string;
    createdAt: string;
    expectedShipAt?: string | null;
    shippedAt?: string | null;
    internalNote?: string | null;
    customer: { email: string; name: string | null };
  };

  function orderTypeLabel(note: string | null | undefined): string {
    if (!note) return "—";
    const match = note.match(/^\[(Drop sale|Workshop|Commission|Other)\]/);
    return match ? match[1] : "—";
  }

  type CustomerSummary = {
    id: string;
    email: string;
    name: string | null;
    phone?: string | null;
    roles?: string[];
    sources?: string[];
    subject?: string | null;
    createdAt: string;
    orderCount: number;
    totalSpentCents: number;
  };

  type AdminEvent = {
    id: string;
    slug: string;
    title: string;
    location: string | null;
    description: string | null;
    color: string | null;
    startsAt: string;
    endsAt: string | null;
    ctaLabel: string | null;
    ctaUrl: string | null;
    raffleEnabled: boolean;
    raffleButtonLabel: string | null;
    raffleClosesAt: string | null;
    raffleDrawCopy: string | null;
  };

  type AdminBatchDrop = {
    id: string;
    dropCode: string;
    productId: string;
    totalUnits: number;
    status: string;
    madeLocation: string;
    madeYear: number;
    releaseAt: string | null;
    product: { id: string; name: string; slug: string; imageUrl: string | null };
    _count?: { units: number; reservations: number };
  };

  type AdminProductOption = {
    id: string;
    name: string;
    slug: string;
    imageUrl: string | null;
  };

  // Selection state for the bulk-email workflow — shared across the Orders
  // and Customers tabs so either one can hand its picks to the Send Email
  // tab. Keyed by order id / customer email respectively; emails are the
  // natural key for customers since that's what a send ultimately needs.
  const selectedOrderIds = new Set<string>();
  const orderEmailsById = new Map<string, string>();
  const selectedCustomerEmails = new Set<string>();

  function updateOrdersEmailButton() {
    const btn = document.getElementById("orders-email-selected") as HTMLButtonElement;
    btn.hidden = selectedOrderIds.size === 0;
    btn.textContent = `Email ${selectedOrderIds.size} selected`;
  }

  function updateCustomersEmailButton() {
    const btn = document.getElementById("customers-email-selected") as HTMLButtonElement;
    btn.hidden = selectedCustomerEmails.size === 0;
    btn.textContent = `Email ${selectedCustomerEmails.size} selected`;
  }

  function money(cents: number, currency = "AUD") {
    return `${currency} $${(cents / 100).toFixed(2)}`;
  }

  function dollarsToCents(value: string): number | null {
    const n = Number(value);
    if (!Number.isFinite(n)) return null;
    return Math.round(n * 100);
  }

  function centsToDollarsStr(cents: number): string {
    return (cents / 100).toFixed(2);
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      ...options,
      headers: { "Content-Type": "application/json", ...(options.headers || {}) },
      credentials: "same-origin",
    });
    if (res.status === 401) {
      window.location.href = "/admin/login";
      throw new Error("Not authenticated");
    }
    return res;
  }

  function showHint(el: HTMLElement, message: string, ok: boolean) {
    el.textContent = message;
    el.hidden = false;
    el.classList.toggle("is-success", ok);
    el.classList.toggle("is-error", !ok);
  }

  function showGlobalError(message: string) {
    const el = document.getElementById("global-error") as HTMLParagraphElement;
    el.textContent = message;
    el.hidden = false;
  }

  // --- Tabs ---
  function activateTab(target: string) {
    document.querySelectorAll<HTMLButtonElement>(".admin__tab").forEach((t) => {
      t.classList.toggle("is-active", t.dataset.tab === target);
    });
    document.querySelectorAll<HTMLElement>(".admin__panel").forEach((panel) => {
      panel.hidden = panel.dataset.panel !== target;
    });
    if (target === "pricing") loadProduct();
    if (target === "inventory") loadInventory();
    if (target === "customers") loadCustomers();
    if (target === "events") loadEvents();
    if (target === "batch-drops") loadBatchDrops();
  }
  document.querySelectorAll<HTMLButtonElement>(".admin__tab").forEach((tab) => {
    tab.addEventListener("click", () => activateTab(tab.dataset.tab as string));
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" }).catch(() => {});
    window.location.href = "/admin/login";
  });

  // --- Orders ---
  // Renders one order table row. Extracted from loadOrders() so both the
  // full-list render and a single-row patch (after mark-paid/mark-shipped/
  // update-ship-date/update-order-details, see patchOrderRow below) share
  // exactly one implementation. Every interpolated value is passed through
  // esc() — this function must be XSS-safe standing on its own, since a
  // customer-supplied value (billing/order name) can flow into o.customer
  // via Stripe checkout.
  function renderOrderRow(o: OrderSummary): string {
    const noteTitle = o.internalNote ? esc(o.internalNote) : "";
    const noteFlag = o.internalNote?.includes("⚠️")
      ? ` <span class="admin-flag" title="${noteTitle}">⚠️ review</span>`
      : o.internalNote
        ? ` <span class="admin-flag admin-flag--muted" title="${noteTitle}">📝</span>`
        : "";
    const overdue = !o.shippedAt && o.expectedShipAt && new Date(o.expectedShipAt).getTime() <= Date.now();
    const shipByCell = o.shippedAt
      ? `Shipped ${esc(new Date(o.shippedAt).toLocaleDateString())}`
      : o.expectedShipAt
        ? `<span class="${overdue ? "admin-shipby--overdue" : ""}">${overdue ? "Overdue — " : ""}${esc(new Date(o.expectedShipAt).toLocaleDateString())}</span>`
        : "—";
    const id = esc(o.id);
    return `
        <tr data-order-row data-id="${id}">
          <td class="admin-table__checkbox-col" data-checkbox-cell><input type="checkbox" class="order-select-checkbox" data-order-id="${id}" aria-label="Select order ${esc(o.orderNumber)}" /></td>
          <td>${esc(o.orderNumber)}${noteFlag}</td>
          <td>${esc(o.customer?.name || o.customer?.email || "—")}</td>
          <td>${esc(orderTypeLabel(o.internalNote))}</td>
          <td>${esc(o.status)}</td>
          <td>${esc(money(o.totalCents, o.currency))}</td>
          <td>${shipByCell}</td>
          <td>${esc(new Date(o.createdAt).toLocaleDateString())}</td>
        </tr>`;
  }

  // Attaches the row-click and checkbox listeners to one already-rendered
  // <tr data-order-row>. Shared between the full-list render (one pass over
  // every row) and a single-row patch (just the replaced row) so a patched
  // row never ends up without its click/select behaviour.
  function bindOrderRow(row: HTMLTableRowElement, tbody: HTMLTableSectionElement) {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-checkbox-cell]")) return;
      openOrderDetail(row.dataset.id as string);
    });
    const cb = row.querySelector<HTMLInputElement>(".order-select-checkbox");
    if (!cb) return;
    cb.checked = selectedOrderIds.has(cb.dataset.orderId as string);
    cb.addEventListener("click", (e) => e.stopPropagation());
    cb.addEventListener("change", () => {
      const id = cb.dataset.orderId as string;
      if (cb.checked) selectedOrderIds.add(id);
      else selectedOrderIds.delete(id);
      updateOrdersEmailButton();
      const all = tbody.querySelectorAll<HTMLInputElement>(".order-select-checkbox");
      const selectAll = document.getElementById("orders-select-all") as HTMLInputElement;
      selectAll.checked = all.length > 0 && tbody.querySelectorAll(".order-select-checkbox:checked").length === all.length;
    });
  }

  async function loadOrders() {
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    try {
      const res = await api("/api/admin/orders");
      if (!res.ok) throw new Error("Failed to load orders");
      const { orders } = (await res.json()) as { orders: OrderSummary[] };
      orderEmailsById.clear();
      if (orders.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="admin-table__empty">No orders yet.</td></tr>`;
        updateOrdersEmailButton();
        return;
      }
      orders.forEach((o) => orderEmailsById.set(o.id, o.customer?.email || ""));
      tbody.innerHTML = orders.map(renderOrderRow).join("");
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-order-row]").forEach((row) => bindOrderRow(row, tbody));
      updateOrdersEmailButton();
    } catch {
      tbody.innerHTML = `<tr><td colspan="8" class="admin-table__empty">Couldn't load orders.</td></tr>`;
    }
  }

  // Replaces exactly the one row for updatedOrder in place, instead of the
  // full 200-row loadOrders() refetch + tbody rebuild the four order-detail
  // actions used to trigger. Falls back to a full loadOrders() only if the
  // row can't be found (e.g. it scrolled out of the currently-loaded list),
  // so behaviour degrades safely rather than silently doing nothing.
  function patchOrderRow(updatedOrder: OrderSummary) {
    orderEmailsById.set(updatedOrder.id, updatedOrder.customer?.email || "");
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    const existingRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-order-row][data-id="${CSS.escape(updatedOrder.id)}"]`);
    if (!existingRow) {
      loadOrders();
      return;
    }
    existingRow.outerHTML = renderOrderRow(updatedOrder);
    const newRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-order-row][data-id="${CSS.escape(updatedOrder.id)}"]`);
    if (newRow) bindOrderRow(newRow, tbody);
  }

  document.getElementById("orders-select-all")?.addEventListener("change", (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    tbody.querySelectorAll<HTMLInputElement>(".order-select-checkbox").forEach((cb) => {
      cb.checked = checked;
      const id = cb.dataset.orderId as string;
      if (checked) selectedOrderIds.add(id);
      else selectedOrderIds.delete(id);
    });
    updateOrdersEmailButton();
  });

  document.getElementById("orders-email-selected")?.addEventListener("click", () => {
    const emails = Array.from(selectedOrderIds)
      .map((id) => orderEmailsById.get(id))
      .filter((e): e is string => !!e);
    const unique = Array.from(new Set(emails));
    (document.getElementById("email-to") as HTMLTextAreaElement).value = unique.join("\n");
    activateTab("email");
  });

  async function openOrderDetail(id: string) {
    const detail = document.getElementById("order-detail") as HTMLDivElement;
    try {
      const res = await api(`/api/admin/orders?id=${encodeURIComponent(id)}`);
      if (!res.ok) throw new Error("not found");
      const { order } = await res.json();
      detail.hidden = false;
      (document.getElementById("detail-number") as HTMLElement).textContent = order.orderNumber;
      (document.getElementById("detail-summary") as HTMLElement).innerHTML = `
        <dt>Customer</dt><dd>${esc(order.customer.email)}${order.customer.name ? ` (${esc(order.customer.name)})` : ""}</dd>
        <dt>Status</dt><dd>${order.status}</dd>
        <dt>Total</dt><dd>${money(order.totalCents, order.currency)}</dd>
        <dt>Placed</dt><dd>${new Date(order.createdAt).toLocaleString()}</dd>
        <dt>Shipped</dt><dd>${order.shippedAt ? new Date(order.shippedAt).toLocaleString() : "Not yet"}</dd>
      `;
      (document.getElementById("detail-items") as HTMLElement).innerHTML = order.items
        .map(
          (it: any) =>
            `<li>${it.quantity} × ${esc(it.product?.name || "Item")}${it.unit?.serial ? ` — unit ${esc(it.unit.serial)}` : ""} — ${money(it.lineTotalCents, order.currency)}</li>`,
        )
        .join("") || "<li>No items</li>";
      const addr = order.deliveryAddress;
      (document.getElementById("detail-address-empty-hint") as HTMLElement).hidden = !!addr;
      (document.getElementById("detail-addr-recipient") as HTMLInputElement).value = addr?.recipientName || "";
      (document.getElementById("detail-addr-line1") as HTMLInputElement).value = addr?.line1 || "";
      (document.getElementById("detail-addr-line2") as HTMLInputElement).value = addr?.line2 || "";
      (document.getElementById("detail-addr-suburb") as HTMLInputElement).value = addr?.suburb || "";
      (document.getElementById("detail-addr-state") as HTMLInputElement).value = addr?.state || "";
      (document.getElementById("detail-addr-postcode") as HTMLInputElement).value = addr?.postcode || "";
      (document.getElementById("detail-note") as HTMLTextAreaElement).value = order.internalNote || "";

      const orderSaveBtn = document.getElementById("detail-order-save") as HTMLButtonElement;
      const orderSaveStatus = document.getElementById("order-details-status") as HTMLElement;
      orderSaveStatus.hidden = true;
      orderSaveBtn.onclick = async () => {
        orderSaveBtn.disabled = true;
        orderSaveStatus.hidden = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({
              action: "update-order-details",
              orderId: order.id,
              recipientName: (document.getElementById("detail-addr-recipient") as HTMLInputElement).value.trim(),
              addressLine1: (document.getElementById("detail-addr-line1") as HTMLInputElement).value.trim(),
              addressLine2: (document.getElementById("detail-addr-line2") as HTMLInputElement).value.trim(),
              suburb: (document.getElementById("detail-addr-suburb") as HTMLInputElement).value.trim(),
              state: (document.getElementById("detail-addr-state") as HTMLInputElement).value.trim(),
              postcode: (document.getElementById("detail-addr-postcode") as HTMLInputElement).value.trim(),
              internalNote: (document.getElementById("detail-note") as HTMLTextAreaElement).value.trim(),
            }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(orderSaveStatus, "Saved.", true);
            patchOrderRow(data.order);
          } else {
            showHint(orderSaveStatus, data.error || "Failed to save.", false);
          }
        } catch {
          showHint(orderSaveStatus, "Network error.", false);
        } finally {
          orderSaveBtn.disabled = false;
        }
      };

      (document.getElementById("detail-payments") as HTMLElement).innerHTML =
        order.payments
          .map((p: any) => `<li>${esc(p.provider)} — ${esc(p.status)} — ${money(p.amountCents, order.currency)}</li>`)
          .join("") || "<li>No payments recorded</li>";

      const shipDateInput = document.getElementById("detail-ship-date") as HTMLInputElement;
      const shipDateSaveBtn = document.getElementById("detail-ship-date-save") as HTMLButtonElement;
      const shipDateStatus = document.getElementById("ship-date-status") as HTMLElement;
      shipDateStatus.hidden = true;
      shipDateInput.value = order.expectedShipAt ? new Date(order.expectedShipAt).toISOString().slice(0, 10) : "";
      shipDateSaveBtn.onclick = async () => {
        const value = shipDateInput.value;
        if (!value) {
          showHint(shipDateStatus, "Pick a date first.", false);
          return;
        }
        shipDateSaveBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "update-ship-date", orderId: order.id, expectedShipAt: value }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(shipDateStatus, "Ship-by date updated.", true);
            patchOrderRow(data.order);
          } else {
            showHint(shipDateStatus, data.error || "Failed to update.", false);
          }
        } catch {
          showHint(shipDateStatus, "Network error.", false);
        } finally {
          shipDateSaveBtn.disabled = false;
        }
      };

      const paidBtn = document.getElementById("mark-paid") as HTMLButtonElement;
      const paidStatus = document.getElementById("paid-status") as HTMLElement;
      paidStatus.hidden = true;
      paidBtn.hidden = order.status !== "PENDING_PAYMENT";
      paidBtn.onclick = async () => {
        paidBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "mark-paid", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(paidStatus, "Marked as paid.", true);
            paidBtn.hidden = true;
            openOrderDetail(order.id);
            patchOrderRow(data.order);
          } else {
            showHint(paidStatus, data.error || "Failed to update.", false);
            paidBtn.disabled = false;
          }
        } catch {
          showHint(paidStatus, "Network error.", false);
          paidBtn.disabled = false;
        }
      };

      const resendBtn = document.getElementById("resend-confirmation") as HTMLButtonElement;
      const resendStatus = document.getElementById("resend-status") as HTMLElement;
      resendStatus.hidden = true;
      resendBtn.onclick = async () => {
        resendBtn.disabled = true;
        try {
          const r = await api("/api/admin/send-email", {
            method: "POST",
            body: JSON.stringify({ mode: "resend-confirmation", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) showHint(resendStatus, "Confirmation email sent.", true);
          else showHint(resendStatus, data.error || "Failed to send.", false);
        } catch {
          showHint(resendStatus, "Network error.", false);
        } finally {
          resendBtn.disabled = false;
        }
      };

      const shipBtn = document.getElementById("mark-shipped") as HTMLButtonElement;
      const shipStatus = document.getElementById("ship-status") as HTMLElement;
      shipStatus.hidden = true;
      shipBtn.disabled = !!order.shippedAt;
      shipBtn.textContent = order.shippedAt ? "Already marked shipped" : "Mark as shipped";
      shipBtn.onclick = async () => {
        shipBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "mark-shipped", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(shipStatus, "Marked as shipped.", true);
            shipBtn.textContent = "Already marked shipped";
            openOrderDetail(order.id);
            patchOrderRow(data.order);
          } else {
            showHint(shipStatus, data.error || "Failed to update.", false);
            shipBtn.disabled = false;
          }
        } catch {
          showHint(shipStatus, "Network error.", false);
          shipBtn.disabled = false;
        }
      };

      const deleteBtn = document.getElementById("delete-test-order") as HTMLButtonElement;
      const deleteStatus = document.getElementById("delete-order-status") as HTMLElement;
      deleteStatus.hidden = true;
      deleteBtn.onclick = async () => {
        const warning = order.shippedAt
          ? `Order ${order.orderNumber} has already been marked shipped — this permanently deletes it and puts any numbered unit(s) it sold back IN_STOCK as if never sold. This cannot be undone. Continue?`
          : `Permanently delete order ${order.orderNumber} and put any numbered unit(s) it sold back IN_STOCK as if never sold? This cannot be undone.`;
        if (!window.confirm(warning)) return;
        deleteBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "delete-test-order", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            (document.getElementById("order-detail") as HTMLDivElement).hidden = true;
            loadOrders();
          } else {
            showHint(deleteStatus, data.error || "Failed to delete.", false);
            deleteBtn.disabled = false;
          }
        } catch {
          showHint(deleteStatus, "Network error.", false);
          deleteBtn.disabled = false;
        }
      };
    } catch {
      showGlobalError("Couldn't load that order.");
    }
  }

  document.getElementById("detail-close")?.addEventListener("click", () => {
    (document.getElementById("order-detail") as HTMLDivElement).hidden = true;
  });
  document.getElementById("orders-refresh")?.addEventListener("click", loadOrders);

  // --- Customers & Audience Directory ---
  let allCustomersCache: CustomerSummary[] = [];
  let currentCustomerFilter = "all";
  const customersCache = new Map<string, CustomerSummary>();

  function renderRoleBadges(roles: string[] = []): string {
    const labels: Record<string, string> = {
      customer: "Buyer",
      subscriber: "Subscriber",
      raffle: "Raffle",
      contact: "Inquiry",
      playground_export: "3D Export",
    };
    return roles
      .map((r) => `<span class="admin-badge admin-badge--${esc(r)}">${esc(labels[r] || r)}</span>`)
      .join(" ");
  }

  function renderCustomerRow(c: CustomerSummary): string {
    const email = esc(c.email);
    const badgesHtml = renderRoleBadges(c.roles);
    let activityText = "Lead";
    if (c.orderCount > 0) {
      activityText = `<strong>${esc(c.orderCount)}</strong> order(s) · ${esc(money(c.totalSpentCents))}`;
    } else if (c.subject) {
      activityText = `<span class="admin-muted">Inquiry:</span> ${esc(c.subject.slice(0, 30))}${c.subject.length > 30 ? "…" : ""}`;
    } else if (c.sources && c.sources.length > 0) {
      activityText = `<span class="admin-muted">Source:</span> ${esc(c.sources[0])}`;
    }

    return `
        <tr data-customer-row data-customer-id="${esc(c.id)}">
          <td class="admin-table__checkbox-col"><input type="checkbox" class="customer-select-checkbox" data-email="${email}" aria-label="Select ${email}" /></td>
          <td>${email}</td>
          <td>${esc(c.name || "—")}</td>
          <td>${badgesHtml || '<span class="admin-muted">—</span>'}</td>
          <td>${activityText}</td>
          <td>${esc(new Date(c.createdAt).toLocaleDateString())}</td>
        </tr>`;
  }

  function bindCustomerRow(row: HTMLTableRowElement, tbody: HTMLTableSectionElement) {
    const cb = row.querySelector<HTMLInputElement>(".customer-select-checkbox");
    if (cb) {
      cb.checked = selectedCustomerEmails.has(cb.dataset.email as string);
      cb.addEventListener("change", (e) => {
        e.stopPropagation();
        const email = cb.dataset.email as string;
        if (cb.checked) selectedCustomerEmails.add(email);
        else selectedCustomerEmails.delete(email);
        updateCustomersEmailButton();
        const all = tbody.querySelectorAll<HTMLInputElement>(".customer-select-checkbox");
        const selectAll = document.getElementById("customers-select-all") as HTMLInputElement;
        selectAll.checked = all.length > 0 && tbody.querySelectorAll(".customer-select-checkbox:checked").length === all.length;
      });
    }
    row.addEventListener("click", () => openCustomerDetail(row.dataset.customerId as string));
  }

  function renderFilteredCustomers() {
    const tbody = document.getElementById("customers-tbody") as HTMLTableSectionElement;
    const query = ((document.getElementById("customers-search") as HTMLInputElement)?.value || "").toLowerCase().trim();

    let filtered = allCustomersCache;
    if (currentCustomerFilter === "customers") {
      filtered = filtered.filter((c) => c.roles?.includes("customer"));
    } else if (currentCustomerFilter === "subscribers") {
      filtered = filtered.filter((c) => c.roles?.includes("subscriber"));
    } else if (currentCustomerFilter === "raffles") {
      filtered = filtered.filter((c) => c.roles?.includes("raffle"));
    } else if (currentCustomerFilter === "contacts") {
      filtered = filtered.filter((c) => c.roles?.includes("contact"));
    } else if (currentCustomerFilter === "exports") {
      filtered = filtered.filter((c) => c.roles?.includes("playground_export"));
    }

    if (query) {
      filtered = filtered.filter((c) =>
        c.email.toLowerCase().includes(query) ||
        (c.name && c.name.toLowerCase().includes(query)) ||
        (c.roles && c.roles.some((r) => r.toLowerCase().includes(query))) ||
        (c.subject && c.subject.toLowerCase().includes(query))
      );
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">No matching contacts found.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered.map(renderCustomerRow).join("");
    tbody.querySelectorAll<HTMLTableRowElement>("tr[data-customer-row]").forEach((row) => bindCustomerRow(row, tbody));
  }

  async function loadCustomers() {
    const tbody = document.getElementById("customers-tbody") as HTMLTableSectionElement;
    try {
      const res = await api("/api/admin/customers");
      if (!res.ok) throw new Error("Failed to load customers");
      const { customers, counts } = (await res.json()) as { customers: CustomerSummary[]; counts?: Record<string, number> };
      allCustomersCache = customers;
      customersCache.clear();
      customers.forEach((c) => customersCache.set(c.id, c));

      if (counts) {
        const updateCount = (id: string, val: number | undefined) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(val ?? 0);
        };
        updateCount("count-all", counts.all);
        updateCount("count-customers", counts.customers);
        updateCount("count-subscribers", counts.subscribers);
        updateCount("count-raffles", counts.raffles);
        updateCount("count-contacts", counts.contacts);
        updateCount("count-exports", counts.exports);
      }

      renderFilteredCustomers();
      updateCustomersEmailButton();
    } catch {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">Couldn't load customers.</td></tr>`;
    }
  }

  document.getElementById("customer-filter-pills")?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".admin-pill");
    if (!btn) return;
    document.querySelectorAll("#customer-filter-pills .admin-pill").forEach((p) => p.classList.remove("is-active"));
    btn.classList.add("is-active");
    currentCustomerFilter = btn.dataset.filter || "all";
    renderFilteredCustomers();
  });

  document.getElementById("customers-search")?.addEventListener("input", renderFilteredCustomers);

  function patchCustomerRow(saved: { id: string; email: string; name: string | null; createdAt: string }) {
    const previous = customersCache.get(saved.id);
    if (!previous) {
      loadCustomers();
      return;
    }
    const updated: CustomerSummary = { ...previous, email: saved.email, name: saved.name, createdAt: saved.createdAt };
    customersCache.set(saved.id, updated);
    const idx = allCustomersCache.findIndex((c) => c.id === saved.id);
    if (idx !== -1) allCustomersCache[idx] = updated;
    renderFilteredCustomers();
  }

  async function openCustomerDetail(id: string) {
    const detail = document.getElementById("customer-detail") as HTMLDivElement;
    const status = document.getElementById("customer-detail-status") as HTMLElement;
    const badgesRow = document.getElementById("customer-badges-row") as HTMLElement;
    const extraInfo = document.getElementById("customer-extra-info") as HTMLElement;
    status.hidden = true;

    const contact = customersCache.get(id);
    if (!contact) {
      showGlobalError("Couldn't find that contact record.");
      return;
    }

    detail.hidden = false;
    badgesRow.innerHTML = renderRoleBadges(contact.roles);
    (document.getElementById("cd-email") as HTMLInputElement).value = contact.email;
    (document.getElementById("cd-name") as HTMLInputElement).value = contact.name || "";
    (document.getElementById("cd-phone") as HTMLInputElement).value = contact.phone || "";

    const infoParts: string[] = [];
    if (contact.orderCount > 0) {
      infoParts.push(`<p class="admin-muted"><strong>Purchase History:</strong> ${contact.orderCount} order(s) totalling ${money(contact.totalSpentCents)}.</p>`);
    }
    if (contact.sources && contact.sources.length > 0) {
      infoParts.push(`<p class="admin-muted"><strong>Capture Touchpoints:</strong> ${esc(contact.sources.join(", "))}</p>`);
    }
    if (contact.subject) {
      infoParts.push(`<p class="admin-muted"><strong>Inquiry Subject:</strong> ${esc(contact.subject)}</p>`);
    }
    extraInfo.innerHTML = infoParts.join("");

    const saveBtn = document.getElementById("customer-detail-save") as HTMLButtonElement;
    saveBtn.onclick = async () => {
      const email = (document.getElementById("cd-email") as HTMLInputElement).value.trim();
      const name = (document.getElementById("cd-name") as HTMLInputElement).value.trim();
      const phone = (document.getElementById("cd-phone") as HTMLInputElement).value.trim();
      if (!email) return showHint(status, "Email can't be blank.", false);
      saveBtn.disabled = true;
      try {
        const r = await api("/api/admin/customers", {
          method: "POST",
          body: JSON.stringify({ customerId: contact.id.startsWith("sub-") || contact.id.startsWith("ct-") ? undefined : contact.id, email, name: name || null, phone: phone || null }),
        });
        const data = await r.json();
        if (r.ok) {
          showHint(status, "Saved.", true);
          patchCustomerRow(data.customer || { id: contact.id, email, name, createdAt: contact.createdAt });
        } else {
          showHint(status, data.error || "Failed to save.", false);
        }
      } catch {
        showHint(status, "Network error.", false);
      } finally {
        saveBtn.disabled = false;
      }
    };
  }

  document.getElementById("customer-detail-close")?.addEventListener("click", () => {
    (document.getElementById("customer-detail") as HTMLDivElement).hidden = true;
  });

  document.getElementById("customers-select-all")?.addEventListener("change", (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    const tbody = document.getElementById("customers-tbody") as HTMLTableSectionElement;
    tbody.querySelectorAll<HTMLInputElement>(".customer-select-checkbox").forEach((cb) => {
      cb.checked = checked;
      const email = cb.dataset.email as string;
      if (checked) selectedCustomerEmails.add(email);
      else selectedCustomerEmails.delete(email);
    });
    updateCustomersEmailButton();
  });

  document.getElementById("customers-refresh")?.addEventListener("click", loadCustomers);

  document.getElementById("customers-email-selected")?.addEventListener("click", () => {
    (document.getElementById("email-to") as HTMLTextAreaElement).value = Array.from(selectedCustomerEmails).join("\n");
    activateTab("email");
  });

  // --- Events Management ---
  const eventsCache = new Map<string, AdminEvent>();
  let currentEditingEventId: string | null = null;

  function toLocalDatetimeInput(dateStr: string | null | undefined): string {
    if (!dateStr) return "";
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return "";
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function renderEventRow(e: AdminEvent): string {
    const now = Date.now();
    const effectiveEnd = (e.endsAt ? new Date(e.endsAt) : new Date(e.startsAt)).getTime();
    const isUpcoming = effectiveEnd >= now;
    const raffleOpen = e.raffleEnabled && e.raffleClosesAt && new Date(e.raffleClosesAt).getTime() > now;
    const colorHex = e.color || "#6D771A";

    const raffleStatusHtml = !e.raffleEnabled
      ? '<span class="admin-muted">No raffle</span>'
      : raffleOpen
        ? '<span class="admin-status-chip" data-status="IN_STOCK">Raffle Open</span>'
        : '<span class="admin-status-chip" data-status="VOID">Raffle Closed</span>';

    return `
      <tr data-event-row data-event-id="${esc(e.id)}">
        <td><strong>${esc(e.title)}</strong> ${isUpcoming ? '<span class="admin-status-chip" data-status="IN_STOCK">Upcoming</span>' : '<span class="admin-muted">(Past)</span>'}</td>
        <td>${esc(new Date(e.startsAt).toLocaleDateString())}</td>
        <td>${esc(e.endsAt ? new Date(e.endsAt).toLocaleDateString() : "—")}</td>
        <td><span class="event-color-chip" style="background:${esc(colorHex)};"></span> <code>${esc(colorHex)}</code></td>
        <td>${raffleStatusHtml}</td>
        <td>${esc(e.location || "—")}</td>
      </tr>`;
  }

  async function loadEvents() {
    const tbody = document.getElementById("events-tbody") as HTMLTableSectionElement;
    try {
      const res = await api("/api/admin/events");
      if (!res.ok) throw new Error("Failed to load events");
      const { events } = (await res.json()) as { events: AdminEvent[] };
      eventsCache.clear();
      if (events.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">No events yet. Click "+ New event" above.</td></tr>`;
        return;
      }
      events.forEach((ev) => eventsCache.set(ev.id, ev));
      tbody.innerHTML = events.map(renderEventRow).join("");
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-event-row]").forEach((row) => {
        row.style.cursor = "pointer";
        row.addEventListener("click", () => openEventDetail(row.dataset.eventId as string));
      });
    } catch {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">Couldn't load events.</td></tr>`;
    }
  }

  function setEventColor(hex: string) {
    const picker = document.getElementById("ed-color-picker") as HTMLInputElement;
    const textInput = document.getElementById("ed-color") as HTMLInputElement;
    const badge = document.getElementById("ed-color-preview-badge") as HTMLElement;
    if (picker) picker.value = hex;
    if (textInput) textInput.value = hex;
    if (badge) badge.style.backgroundColor = hex;
  }

  document.getElementById("ed-color-picker")?.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value;
    setEventColor(val);
  });
  document.getElementById("ed-color")?.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value.trim();
    if (/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(val)) {
      setEventColor(val);
    }
  });
  document.querySelectorAll<HTMLButtonElement>(".admin-color-swatch").forEach((swatch) => {
    swatch.addEventListener("click", () => {
      const color = swatch.dataset.color;
      if (color) setEventColor(color);
    });
  });

  function openEventDetail(id?: string) {
    const detail = document.getElementById("event-detail") as HTMLDivElement;
    const heading = document.getElementById("event-detail-heading") as HTMLElement;
    const deleteBtn = document.getElementById("event-detail-delete") as HTMLButtonElement;
    const status = document.getElementById("event-detail-status") as HTMLElement;
    status.hidden = true;
    currentEditingEventId = id || null;

    if (!id) {
      heading.textContent = "New event";
      deleteBtn.hidden = true;
      (document.getElementById("ed-title") as HTMLInputElement).value = "";
      (document.getElementById("ed-slug") as HTMLInputElement).value = "";
      (document.getElementById("ed-location") as HTMLInputElement).value = "";
      (document.getElementById("ed-starts-at") as HTMLInputElement).value = "";
      (document.getElementById("ed-ends-at") as HTMLInputElement).value = "";
      (document.getElementById("ed-cta-label") as HTMLInputElement).value = "";
      (document.getElementById("ed-cta-url") as HTMLInputElement).value = "";
      (document.getElementById("ed-description") as HTMLTextAreaElement).value = "";
      setEventColor("#6D771A");
      (document.getElementById("ed-raffle-enabled") as HTMLInputElement).checked = false;
      (document.getElementById("ed-raffle-button-label") as HTMLInputElement).value = "";
      (document.getElementById("ed-raffle-closes-at") as HTMLInputElement).value = "";
      (document.getElementById("ed-raffle-draw-copy") as HTMLTextAreaElement).value = "";
      detail.hidden = false;
      return;
    }

    const event = eventsCache.get(id);
    if (!event) return;
    heading.textContent = `Edit event: ${event.title}`;
    deleteBtn.hidden = false;
    (document.getElementById("ed-title") as HTMLInputElement).value = event.title;
    (document.getElementById("ed-slug") as HTMLInputElement).value = event.slug;
    (document.getElementById("ed-location") as HTMLInputElement).value = event.location || "";
    (document.getElementById("ed-starts-at") as HTMLInputElement).value = toLocalDatetimeInput(event.startsAt);
    (document.getElementById("ed-ends-at") as HTMLInputElement).value = toLocalDatetimeInput(event.endsAt);
    (document.getElementById("ed-cta-label") as HTMLInputElement).value = event.ctaLabel || "";
    (document.getElementById("ed-cta-url") as HTMLInputElement).value = event.ctaUrl || "";
    (document.getElementById("ed-description") as HTMLTextAreaElement).value = event.description || "";
    setEventColor(event.color || "#6D771A");
    (document.getElementById("ed-raffle-enabled") as HTMLInputElement).checked = !!event.raffleEnabled;
    (document.getElementById("ed-raffle-button-label") as HTMLInputElement).value = event.raffleButtonLabel || "";
    (document.getElementById("ed-raffle-closes-at") as HTMLInputElement).value = toLocalDatetimeInput(event.raffleClosesAt);
    (document.getElementById("ed-raffle-draw-copy") as HTMLTextAreaElement).value = event.raffleDrawCopy || "";
    detail.hidden = false;
  }

  document.getElementById("events-new")?.addEventListener("click", () => openEventDetail());
  document.getElementById("events-refresh")?.addEventListener("click", loadEvents);
  document.getElementById("event-detail-close")?.addEventListener("click", () => {
    (document.getElementById("event-detail") as HTMLDivElement).hidden = true;
  });

  document.getElementById("event-detail-save")?.addEventListener("click", async () => {
    const status = document.getElementById("event-detail-status") as HTMLElement;
    const title = (document.getElementById("ed-title") as HTMLInputElement).value.trim();
    const slug = (document.getElementById("ed-slug") as HTMLInputElement).value.trim();
    const location = (document.getElementById("ed-location") as HTMLInputElement).value.trim();
    const startsAt = (document.getElementById("ed-starts-at") as HTMLInputElement).value;
    const endsAt = (document.getElementById("ed-ends-at") as HTMLInputElement).value;
    const ctaLabel = (document.getElementById("ed-cta-label") as HTMLInputElement).value.trim();
    const ctaUrl = (document.getElementById("ed-cta-url") as HTMLInputElement).value.trim();
    const description = (document.getElementById("ed-description") as HTMLTextAreaElement).value.trim();
    const color = (document.getElementById("ed-color") as HTMLInputElement).value.trim();
    const raffleEnabled = (document.getElementById("ed-raffle-enabled") as HTMLInputElement).checked;
    const raffleButtonLabel = (document.getElementById("ed-raffle-button-label") as HTMLInputElement).value.trim();
    const raffleClosesAt = (document.getElementById("ed-raffle-closes-at") as HTMLInputElement).value;
    const raffleDrawCopy = (document.getElementById("ed-raffle-draw-copy") as HTMLTextAreaElement).value.trim();

    if (!title || !slug || !startsAt) {
      return showHint(status, "Title, slug, and start date are required.", false);
    }

    try {
      const res = await api("/api/admin/events", {
        method: "POST",
        body: JSON.stringify({
          id: currentEditingEventId || undefined,
          title,
          slug,
          location: location || null,
          startsAt: new Date(startsAt).toISOString(),
          endsAt: endsAt ? new Date(endsAt).toISOString() : null,
          ctaLabel: ctaLabel || null,
          ctaUrl: ctaUrl || null,
          description: description || null,
          color: color || null,
          raffleEnabled,
          raffleButtonLabel: raffleButtonLabel || null,
          raffleClosesAt: raffleClosesAt ? new Date(raffleClosesAt).toISOString() : null,
          raffleDrawCopy: raffleDrawCopy || null,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        showHint(status, "Event saved successfully.", true);
        loadEvents();
      } else {
        showHint(status, data.error || "Failed to save event.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  document.getElementById("event-detail-delete")?.addEventListener("click", async () => {
    if (!currentEditingEventId) return;
    if (!confirm("Are you sure you want to permanently delete this event?")) return;
    const status = document.getElementById("event-detail-status") as HTMLElement;
    try {
      const res = await api(`/api/admin/events?id=${encodeURIComponent(currentEditingEventId)}`, {
        method: "DELETE",
      });
      if (res.ok) {
        (document.getElementById("event-detail") as HTMLDivElement).hidden = true;
        loadEvents();
      } else {
        const data = await res.json();
        showHint(status, data.error || "Failed to delete event.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  // --- Batch Drops as Events (Distinct Section) ---
  const batchDropsCache = new Map<string, AdminBatchDrop>();
  let currentEditingDropId: string | null = null;

  function renderBatchDropRow(d: AdminBatchDrop): string {
    const releaseStr = d.releaseAt
      ? `${new Date(d.releaseAt).toLocaleDateString()} ${new Date(d.releaseAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`
      : "Unscheduled";
    const statusMap: Record<string, string> = {
      UPCOMING: '<span class="admin-status-chip" data-status="RESERVED">UPCOMING</span>',
      LIVE: '<span class="admin-status-chip" data-status="IN_STOCK">LIVE</span>',
      SOLD_OUT: '<span class="admin-status-chip" data-status="SOLD">SOLD OUT</span>',
      ARCHIVED: '<span class="admin-status-chip" data-status="VOID">ARCHIVED</span>',
    };

    return `
      <tr data-batch-drop-row data-drop-id="${esc(d.id)}">
        <td><span class="admin-drop-code">${esc(d.dropCode)}</span></td>
        <td><strong>${esc(d.product.name)}</strong></td>
        <td>${esc(d.totalUnits)} total</td>
        <td>${esc(releaseStr)}</td>
        <td>${statusMap[d.status] || esc(d.status)}</td>
        <td><button type="button" class="admin-link-btn" data-edit-drop="${esc(d.id)}">Configure</button></td>
      </tr>`;
  }

  async function loadBatchDrops() {
    const tbody = document.getElementById("batch-drops-tbody") as HTMLTableSectionElement;
    const productSelect = document.getElementById("bd-product-id") as HTMLSelectElement;
    try {
      const res = await api("/api/admin/batch-drops");
      if (!res.ok) throw new Error("Failed to load batch drops");
      const { drops, products } = (await res.json()) as { drops: AdminBatchDrop[]; products: AdminProductOption[] };

      batchDropsCache.clear();
      drops.forEach((d) => batchDropsCache.set(d.id, d));

      if (productSelect) {
        productSelect.innerHTML =
          '<option value="">Select a product…</option>' +
          products.map((p) => `<option value="${esc(p.id)}">${esc(p.name)}</option>`).join("");
      }

      if (drops.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">No batch drops found.</td></tr>`;
        return;
      }

      tbody.innerHTML = drops.map(renderBatchDropRow).join("");
      tbody.querySelectorAll<HTMLButtonElement>("[data-edit-drop]").forEach((btn) => {
        btn.addEventListener("click", () => openBatchDropDetail(btn.dataset.editDrop as string));
      });
    } catch {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">Couldn't load batch drops.</td></tr>`;
    }
  }

  function openBatchDropDetail(id?: string) {
    const detail = document.getElementById("batch-drop-detail") as HTMLDivElement;
    const heading = document.getElementById("batch-drop-detail-heading") as HTMLElement;
    const status = document.getElementById("batch-drop-detail-status") as HTMLElement;
    status.hidden = true;
    currentEditingDropId = id || null;

    if (!id) {
      heading.textContent = "Schedule new batch drop";
      (document.getElementById("bd-product-id") as HTMLSelectElement).disabled = false;
      (document.getElementById("bd-drop-code") as HTMLInputElement).disabled = false;
      (document.getElementById("bd-drop-code") as HTMLInputElement).value = "";
      (document.getElementById("bd-total-units") as HTMLInputElement).value = "100";
      (document.getElementById("bd-release-at") as HTMLInputElement).value = "";
      (document.getElementById("bd-status") as HTMLSelectElement).value = "UPCOMING";
      (document.getElementById("bd-made-location") as HTMLInputElement).value = "Melbourne";
      detail.hidden = false;
      return;
    }

    const drop = batchDropsCache.get(id);
    if (!drop) return;
    heading.textContent = `Configure drop: ${drop.dropCode} (${drop.product.name})`;
    const productSelect = document.getElementById("bd-product-id") as HTMLSelectElement;
    productSelect.value = drop.productId;
    productSelect.disabled = true;
    const codeInput = document.getElementById("bd-drop-code") as HTMLInputElement;
    codeInput.value = drop.dropCode;
    codeInput.disabled = true;

    (document.getElementById("bd-total-units") as HTMLInputElement).value = String(drop.totalUnits);
    (document.getElementById("bd-release-at") as HTMLInputElement).value = toLocalDatetimeInput(drop.releaseAt);
    (document.getElementById("bd-status") as HTMLSelectElement).value = drop.status;
    (document.getElementById("bd-made-location") as HTMLInputElement).value = drop.madeLocation || "Melbourne";
    detail.hidden = false;
  }

  document.getElementById("batch-drops-new")?.addEventListener("click", () => openBatchDropDetail());
  document.getElementById("batch-drops-refresh")?.addEventListener("click", loadBatchDrops);
  document.getElementById("batch-drop-detail-close")?.addEventListener("click", () => {
    (document.getElementById("batch-drop-detail") as HTMLDivElement).hidden = true;
  });

  document.getElementById("batch-drop-detail-save")?.addEventListener("click", async () => {
    const status = document.getElementById("batch-drop-detail-status") as HTMLElement;
    const productId = (document.getElementById("bd-product-id") as HTMLSelectElement).value;
    const dropCode = (document.getElementById("bd-drop-code") as HTMLInputElement).value.trim();
    const totalUnits = parseInt((document.getElementById("bd-total-units") as HTMLInputElement).value, 10);
    const releaseAt = (document.getElementById("bd-release-at") as HTMLInputElement).value;
    const dropStatusVal = (document.getElementById("bd-status") as HTMLSelectElement).value;
    const madeLocation = (document.getElementById("bd-made-location") as HTMLInputElement).value.trim();

    if (!currentEditingDropId && (!productId || !dropCode || !totalUnits)) {
      return showHint(status, "Product, drop code, and total units are required.", false);
    }

    try {
      const res = await api("/api/admin/batch-drops", {
        method: "POST",
        body: JSON.stringify({
          id: currentEditingDropId || undefined,
          productId: currentEditingDropId ? undefined : productId,
          dropCode: currentEditingDropId ? undefined : dropCode,
          totalUnits: isNaN(totalUnits) ? undefined : totalUnits,
          releaseAt: releaseAt ? new Date(releaseAt).toISOString() : null,
          status: dropStatusVal,
          madeLocation: madeLocation || undefined,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        showHint(status, "Batch drop saved successfully.", true);
        loadBatchDrops();
      } else {
        showHint(status, data.error || "Failed to save batch drop.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  // --- Inventory ---
  type UnitSummary = { id: string; serial: string; editionNumber: number; status: string };
  type DropSummary = {
    id: string;
    dropCode: string;
    status: string;
    totalUnits: number;
    releaseAt: string | null;
    product: { id: string; name: string; slug: string; sku: string; imageUrl: string | null };
    statusCounts: Record<string, number>;
    units: UnitSummary[];
  };

  const UNIT_STATUS_LABELS: Record<string, string> = {
    IN_STOCK: "In stock",
    RESERVED: "Reserved",
    SOLD: "Sold",
    SHIPPED: "Shipped",
    DELIVERED: "Delivered",
    REGISTERED: "Registered",
    RETURNED: "Returned",
    VOID: "Void (removed)",
  };

  // Every unit's serial doubles as its passport URL slug (see
  // api/admin/inventory.js), so the QR just needs to encode a permanent
  // link — no dynamic QR service needed, since the *page* the code points
  // to is what changes as the unit's status/owner updates, not the code
  // itself (see the project doc's "QR code" note). Generated entirely in
  // the browser, so there's no server route or image-generation dependency
  // added to the app itself.
  //
  // Loaded via a dynamic import() of jsDelivr's "+esm" build rather than a
  // classic <script src> tag exposing a window.QRCode global — the qrcode
  // package's own browser bundle (lib/browser.min.js) is raw CommonJS
  // (require()/exports, no UMD wrapper), so it throws immediately if
  // loaded as a plain script; only the "+esm" endpoint actually wraps it
  // into something a browser can import directly. Cached in qrModulePromise
  // so it's only fetched once per page load, not once per QR download.
  let qrModulePromise: Promise<any> | null = null;
  function loadQrCodeModule() {
    if (!qrModulePromise) {
      // @ts-expect-error — a browser-native dynamic import of a fully
      // qualified https:// URL. TypeScript has no way to resolve a module
      // type for a URL specifier like this (it isn't a package name or a
      // relative path), so `astro check`/tsc always flags it as "Cannot
      // find module" even though it resolves fine at runtime.
      qrModulePromise = import(/* @vite-ignore */ "https://cdn.jsdelivr.net/npm/qrcode@1.5.4/+esm");
    }
    return qrModulePromise;
  }

  // Renders the QR into a canvas and then stamps the serial as a printed
  // caption underneath, in the exported PNG itself — not just the download
  // filename — since the filename is easy to lose track of once a batch of
  // these gets printed or dropped into a shared folder, and a bare QR code
  // gives no visual way to tell units apart at a glance.
  async function downloadUnitQr(serial: string) {
    const url = `${window.location.origin}/passport/${encodeURIComponent(serial)}`;
    const qrSize = 512;
    const labelHeight = 64;
    try {
      const mod = await loadQrCodeModule();
      const toCanvas: (canvas: HTMLCanvasElement, text: string, opts: any) => Promise<void> =
        mod.toCanvas || mod.default?.toCanvas;

      const qrCanvas = document.createElement("canvas");
      await toCanvas(qrCanvas, url, { width: qrSize, margin: 2 });

      const canvas = document.createElement("canvas");
      canvas.width = qrSize;
      canvas.height = qrSize + labelHeight;
      const ctx = canvas.getContext("2d") as CanvasRenderingContext2D;
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(qrCanvas, 0, 0);
      ctx.fillStyle = "#111111";
      ctx.font = "600 32px system-ui, -apple-system, sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(serial, canvas.width / 2, qrSize + labelHeight / 2);

      const a = document.createElement("a");
      a.href = canvas.toDataURL("image/png");
      a.download = `${serial}-qr.png`;
      document.body.appendChild(a);
      a.click();
      a.remove();
    } catch {
      // Let the next click retry the import in case this failure was a
      // transient network hiccup rather than something permanently wrong.
      qrModulePromise = null;
      window.alert("Couldn't generate that QR code — check your network connection and try again.");
    }
  }

  let inventoryLoaded = false;
  async function loadInventory(force = false) {
    if (inventoryLoaded && !force) return;
    const loadingEl = document.getElementById("inventory-loading") as HTMLElement;
    const contentEl = document.getElementById("inventory-content") as HTMLElement;
    loadingEl.hidden = false;
    loadingEl.textContent = "Loading drops…";
    try {
      const res = await api("/api/admin/inventory");
      if (!res.ok) throw new Error("Failed to load inventory");
      const { drops } = (await res.json()) as { drops: DropSummary[] };
      inventoryLoaded = true;
      loadingEl.hidden = true;
      contentEl.hidden = false;

      if (drops.length === 0) {
        contentEl.innerHTML = `<p class="admin-muted">No drops yet.</p>`;
        return;
      }

      contentEl.innerHTML = drops
        .map((drop) => {
          const countsHtml =
            Object.entries(drop.statusCounts)
              .map(
                ([status, count]) =>
                  `<li><span class="admin-status-chip" data-status="${status}">${UNIT_STATUS_LABELS[status] || status}</span> <strong>${count}</strong></li>`,
              )
              .join("") || "<li>No units yet</li>";
          const inStockCount = drop.statusCounts.IN_STOCK || 0;
          const reservedCount = drop.statusCounts.RESERVED || 0;
          const voidCount = drop.statusCounts.VOID || 0;
          const unitsRows = drop.units
            .map(
              (u) =>
                `<tr><td>${esc(u.serial)}</td><td data-edition-cell>${u.editionNumber}</td><td><span class="admin-status-chip" data-status="${u.status}">${UNIT_STATUS_LABELS[u.status] || u.status}</span></td><td class="admin-unit-actions"><button type="button" class="admin-link-btn" data-qr-btn="${esc(u.serial)}">Download QR</button><button type="button" class="admin-link-btn" data-edit-unit-btn="${u.id}" data-drop-id="${drop.id}">Edit</button></td></tr>`,
            )
            .join("");
          return `
        <div class="admin-card" data-drop-card="${drop.id}">
          <div class="admin-drop-card">
            <img class="admin-drop-photo" src="${esc(drop.product.imageUrl || "")}" alt="${esc(drop.product.name)}" onerror="this.style.visibility='hidden'" />
            <div class="admin-drop-body">
              <h2>${esc(drop.product.name)}<span class="admin-drop-code">${esc(drop.dropCode)}</span> <span class="admin-muted">(${drop.status})</span></h2>
              <ul class="admin-list admin-list--inline">${countsHtml}</ul>
              <p class="admin-muted">${drop.totalUnits} unit(s) total${drop.releaseAt ? ` · released ${new Date(drop.releaseAt).toLocaleDateString()}` : ""}</p>

              <button type="button" class="admin-units-toggle" data-units-toggle="${drop.id}">Show all ${drop.units.length} unit(s) &amp; serials ▾</button>
              <table class="admin-units-table" data-units-table="${drop.id}" hidden>
                <thead><tr><th>Serial</th><th>Edition</th><th>Status</th><th>Passport QR</th></tr></thead>
                <tbody>${unitsRows || '<tr><td colspan="4">No units yet</td></tr>'}</tbody>
              </table>

              <div class="admin-restock-row">
                <div class="admin-field-row">
                  <label for="restock-qty-${drop.id}">Add stock</label>
                  <input id="restock-qty-${drop.id}" type="number" min="1" max="500" step="1" value="10" />
                  <button class="btn-primary" data-restock-btn="${drop.id}" title="Adds new numbered units to this drop">+ Add units</button>
                </div>
                <div class="admin-field-row">
                  <label for="void-qty-${drop.id}">Remove stock</label>
                  <input id="void-qty-${drop.id}" type="number" min="1" max="${Math.max(1, inStockCount)}" step="1" value="1" ${inStockCount === 0 ? "disabled" : ""} />
                  <button class="btn-danger" data-void-btn="${drop.id}" title="Undoes an accidental restock — only removes in-stock units, never a reserved or sold one" ${inStockCount === 0 ? "disabled" : ""}>− Remove units</button>
                </div>
                ${
                  voidCount > 0
                    ? `<div class="admin-field-row">
                         <label for="undo-void-qty-${drop.id}">Bring back</label>
                         <input id="undo-void-qty-${drop.id}" type="number" min="1" max="${voidCount}" step="1" value="1" />
                         <button class="btn-ghost" data-undo-void-btn="${drop.id}" title="Brings the most recently voided units back to In stock — safe, nothing was deleted">↺ Undo void</button>
                       </div>`
                    : ""
                }
              </div>
              <p class="admin-muted">Remove takes back the most recently added in-stock units — it can never touch a unit that's already reserved or sold.</p>
              ${
                reservedCount > 0
                  ? `<div class="admin-field-row">
                       <button class="btn-ghost" data-release-stale-btn="${drop.id}" title="Hands back units stuck in Reserved from an abandoned checkout whose expiry webhook never arrived — only touches reservations older than 30 minutes, never one a customer might still be mid-payment on">↺ Release stuck reservations</button>
                       <span class="admin-muted">${reservedCount} unit(s) currently Reserved</span>
                     </div>`
                  : ""
              }
              ${
                voidCount > 0
                  ? `<div class="admin-field-row">
                       <button class="btn-danger" data-delete-void-btn="${drop.id}" title="Permanently deletes every voided unit on this drop from the database — cannot be undone">⨯ Permanently delete ${voidCount} voided unit(s)</button>
                       <span class="admin-muted">Frees these edition numbers for the next restock. Only safe if none of these serials were ever printed on a real tag.</span>
                     </div>`
                  : ""
              }
              <p class="admin__hint" data-restock-status="${drop.id}" hidden></p>
            </div>
          </div>
        </div>`;
        })
        .join("");

      contentEl.querySelectorAll<HTMLButtonElement>("[data-units-toggle]").forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const dropId = toggle.dataset.unitsToggle as string;
          const table = document.querySelector(`[data-units-table="${dropId}"]`) as HTMLElement;
          table.hidden = !table.hidden;
          const count = table.querySelectorAll("tbody tr").length;
          toggle.textContent = table.hidden ? `Show all ${count} unit(s) & serials ▾` : `Hide unit list ▴`;
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-qr-btn]").forEach((btn) => {
        btn.addEventListener("click", () => downloadUnitQr(btn.dataset.qrBtn as string));
      });

      // Manually correct a single unit's edition number — e.g. when
      // fillEditionGaps (see api/admin/inventory.js) skipped ahead because
      // an old voided test unit still held the number that "should" have
      // been next. Turns the Edition cell + action buttons into an inline
      // input/Save/Cancel for that row only; both Save and Cancel end in a
      // full loadInventory(true) refresh, same as every other action here,
      // so there's never a stale row left with listeners bound to HTML
      // that's since been swapped out from under them.
      contentEl.querySelectorAll<HTMLButtonElement>("[data-edit-unit-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const unitId = btn.dataset.editUnitBtn as string;
          const editDropId = btn.dataset.dropId as string;
          const row = btn.closest("tr") as HTMLElement;
          const editionCell = row.querySelector("[data-edition-cell]") as HTMLElement;
          const actionsCell = row.querySelector(".admin-unit-actions") as HTMLElement;
          const currentEdition = editionCell.textContent?.trim() || "1";

          editionCell.innerHTML = `<input type="number" min="1" max="999" step="1" value="${esc(currentEdition)}" class="admin-unit-edit-input" data-edit-input />`;
          actionsCell.innerHTML = `
            <button type="button" class="btn-primary btn-primary--small" data-edit-save>Save</button>
            <button type="button" class="btn-ghost btn-ghost--small" data-edit-cancel>Cancel</button>
            <span class="admin__hint" data-edit-status hidden></span>
          `;

          const input = editionCell.querySelector<HTMLInputElement>("[data-edit-input]") as HTMLInputElement;
          input.focus();
          input.select();

          actionsCell.querySelector("[data-edit-cancel]")?.addEventListener("click", () => loadInventory(true));

          actionsCell.querySelector("[data-edit-save]")?.addEventListener("click", async () => {
            const statusEl = actionsCell.querySelector("[data-edit-status]") as HTMLElement;
            const newEdition = parseInt(input.value, 10);
            if (!Number.isFinite(newEdition) || newEdition < 1) {
              return showHint(statusEl, "Enter a valid edition number.", false);
            }
            if (String(newEdition) === currentEdition) {
              return loadInventory(true);
            }
            if (
              !window.confirm(
                `Change this unit's edition to ${newEdition}? Its serial and QR slug update to match — only do this if the old serial was never printed on a physical tag.`,
              )
            ) {
              return;
            }
            const saveBtn = actionsCell.querySelector("[data-edit-save]") as HTMLButtonElement;
            saveBtn.disabled = true;
            try {
              const res = await api("/api/admin/inventory", {
                method: "POST",
                body: JSON.stringify({ dropId: editDropId, action: "edit-unit", unitId, editionNumber: newEdition }),
              });
              const data = await res.json();
              if (res.ok) {
                loadInventory(true);
              } else {
                showHint(statusEl, data.error || "Couldn't update that unit.", false);
                saveBtn.disabled = false;
              }
            } catch {
              showHint(statusEl, "Network error.", false);
              saveBtn.disabled = false;
            }
          });
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-restock-btn]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const dropId = btn.dataset.restockBtn as string;
          const qtyInput = document.getElementById(`restock-qty-${dropId}`) as HTMLInputElement;
          const status = document.querySelector(`[data-restock-status="${dropId}"]`) as HTMLElement;
          const quantity = parseInt(qtyInput.value, 10);
          if (!Number.isFinite(quantity) || quantity < 1) {
            return showHint(status, "Enter a valid quantity.", false);
          }
          btn.disabled = true;
          try {
            const res = await api("/api/admin/inventory", {
              method: "POST",
              body: JSON.stringify({ dropId, action: "restock", quantity }),
            });
            const data = await res.json();
            if (res.ok) {
              showHint(status, `Added ${data.unitsAdded} unit(s), starting at edition ${data.startingEdition}.`, true);
              loadInventory(true);
            } else {
              showHint(status, data.error || "Restock failed.", false);
            }
          } catch {
            showHint(status, "Network error.", false);
          } finally {
            btn.disabled = false;
          }
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-void-btn]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const dropId = btn.dataset.voidBtn as string;
          const qtyInput = document.getElementById(`void-qty-${dropId}`) as HTMLInputElement;
          const status = document.querySelector(`[data-restock-status="${dropId}"]`) as HTMLElement;
          const quantity = parseInt(qtyInput.value, 10);
          if (!Number.isFinite(quantity) || quantity < 1) {
            return showHint(status, "Enter a valid quantity.", false);
          }
          if (!window.confirm(`Remove ${quantity} unit(s) from this drop? This only affects in-stock units, never a reserved or sold one.`)) {
            return;
          }
          btn.disabled = true;
          try {
            const res = await api("/api/admin/inventory", {
              method: "POST",
              body: JSON.stringify({ dropId, action: "void", quantity }),
            });
            const data = await res.json();
            if (res.ok) {
              showHint(status, `Removed ${data.unitsVoided} unit(s): ${data.voidedSerials.join(", ")}.`, true);
              loadInventory(true);
            } else {
              showHint(status, data.error || "Couldn't remove those units.", false);
            }
          } catch {
            showHint(status, "Network error.", false);
          } finally {
            btn.disabled = false;
          }
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-release-stale-btn]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const dropId = btn.dataset.releaseStaleBtn as string;
          const status = document.querySelector(`[data-restock-status="${dropId}"]`) as HTMLElement;
          if (
            !window.confirm(
              "Release units stuck in Reserved for over 30 minutes back to in-stock? This never touches a reservation a customer could still be actively paying for.",
            )
          ) {
            return;
          }
          btn.disabled = true;
          try {
            const res = await api("/api/admin/inventory", {
              method: "POST",
              body: JSON.stringify({ dropId, action: "release-stale" }),
            });
            const data = await res.json();
            if (res.ok) {
              showHint(
                status,
                data.unitsReleased > 0
                  ? `Released ${data.unitsReleased} unit(s): ${data.releasedSerials.join(", ")}.`
                  : "Nothing to release — no reservation is over 30 minutes old.",
                true,
              );
              loadInventory(true);
            } else {
              showHint(status, data.error || "Couldn't release those units.", false);
            }
          } catch {
            showHint(status, "Network error.", false);
          } finally {
            btn.disabled = false;
          }
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-undo-void-btn]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const dropId = btn.dataset.undoVoidBtn as string;
          const qtyInput = document.getElementById(`undo-void-qty-${dropId}`) as HTMLInputElement;
          const status = document.querySelector(`[data-restock-status="${dropId}"]`) as HTMLElement;
          const quantity = parseInt(qtyInput.value, 10);
          if (!Number.isFinite(quantity) || quantity < 1) {
            return showHint(status, "Enter a valid quantity.", false);
          }
          btn.disabled = true;
          try {
            const res = await api("/api/admin/inventory", {
              method: "POST",
              body: JSON.stringify({ dropId, action: "undo-void", quantity }),
            });
            const data = await res.json();
            if (res.ok) {
              showHint(status, `Brought back ${data.unitsReactivated} unit(s): ${data.reactivatedSerials.join(", ")}.`, true);
              loadInventory(true);
            } else {
              showHint(status, data.error || "Couldn't bring those units back.", false);
            }
          } catch {
            showHint(status, "Network error.", false);
          } finally {
            btn.disabled = false;
          }
        });
      });

      contentEl.querySelectorAll<HTMLButtonElement>("[data-delete-void-btn]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const dropId = btn.dataset.deleteVoidBtn as string;
          const status = document.querySelector(`[data-restock-status="${dropId}"]`) as HTMLElement;
          if (
            !window.confirm(
              "Permanently delete every voided unit on this drop? This cannot be undone, and only makes sense if none of those serials were ever printed on a real QR tag/postcard — reusing a printed serial breaks its link to the physical kit.",
            )
          ) {
            return;
          }
          btn.disabled = true;
          try {
            const res = await api("/api/admin/inventory", {
              method: "POST",
              body: JSON.stringify({ dropId, action: "delete-void" }),
            });
            const data = await res.json();
            if (res.ok) {
              showHint(
                status,
                data.unitsDeleted > 0
                  ? `Permanently deleted ${data.unitsDeleted} unit(s): ${data.deletedSerials.join(", ")}.`
                  : "Nothing to delete — no voided units on this drop.",
                true,
              );
              loadInventory(true);
            } else {
              showHint(status, data.error || "Couldn't delete those units.", false);
            }
          } catch {
            showHint(status, "Network error.", false);
          } finally {
            btn.disabled = false;
          }
        });
      });
    } catch {
      loadingEl.textContent = "Couldn't load inventory.";
    }
  }

  // --- Pricing ---
  let productLoaded = false;
  async function loadProduct() {
    if (productLoaded) return;
    try {
      const res = await api("/api/admin/product");
      if (!res.ok) throw new Error("Failed to load product");
      const { product } = await res.json();
      productLoaded = true;
      (document.getElementById("pricing-loading") as HTMLElement).hidden = true;
      (document.getElementById("pricing-content") as HTMLElement).hidden = false;

      (document.getElementById("price-override") as HTMLInputElement).value = centsToDollarsStr(product.basePriceCents);
      (document.getElementById("copy-tagline") as HTMLInputElement).value = product.tagline || "";
      (document.getElementById("copy-description") as HTMLTextAreaElement).value = product.description || "";

      const r = product.costRecipe;
      const ms = r?.materialSource;
      if (r && ms) {
        (document.getElementById("r-materialCost") as HTMLInputElement).value = centsToDollarsStr(ms.costCents);
        (document.getElementById("r-materialWidth") as HTMLInputElement).value = String(ms.widthCm);
        (document.getElementById("r-materialHeight") as HTMLInputElement).value = String(ms.heightCm);
        (document.getElementById("r-wastePercent") as HTMLInputElement).value = String(ms.wastePercent);
        (document.getElementById("r-tileSize") as HTMLSelectElement).value = String(r.tileSizeCm);
        (document.getElementById("r-tilesPerKit") as HTMLInputElement).value = String(r.tilesPerKit);
        (document.getElementById("r-labourMinutes") as HTMLInputElement).value = String(r.labourMinutes);
        (document.getElementById("r-labourRate") as HTMLInputElement).value = centsToDollarsStr(r.labourRateCentsPerHour);
        (document.getElementById("r-equipmentCost") as HTMLInputElement).value = centsToDollarsStr(r.equipmentCostCents);
        (document.getElementById("r-opsOverhead") as HTMLInputElement).value = centsToDollarsStr(
          r.operationsOverheadCents ?? 0,
        );
        (document.getElementById("r-givingTiles") as HTMLInputElement).value = String(r.givingTilesPerKit);
        // Margin isn't persisted as its own field — back it out from the last
        // known total cost vs. the current retail price so the form starts
        // somewhere sane; editing and saving will persist it going forward.
        const impliedMargin = product.basePriceCents - (product.lastCostCalculationCents ?? product.basePriceCents);
        (document.getElementById("r-margin") as HTMLInputElement).value = centsToDollarsStr(impliedMargin);
      }
    } catch {
      (document.getElementById("pricing-loading") as HTMLElement).textContent = "Couldn't load product.";
    }
  }

  document.getElementById("price-save")?.addEventListener("click", async () => {
    const status = document.getElementById("price-status") as HTMLElement;
    const cents = dollarsToCents((document.getElementById("price-override") as HTMLInputElement).value);
    if (cents === null || cents <= 0) return showHint(status, "Enter a valid price.", false);
    try {
      const res = await api("/api/admin/product", {
        method: "POST",
        body: JSON.stringify({ section: "price", basePriceCents: cents }),
      });
      const data = await res.json();
      if (res.ok) showHint(status, "Price updated.", true);
      else showHint(status, data.error || "Failed to update.", false);
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  document.getElementById("copy-save")?.addEventListener("click", async () => {
    const status = document.getElementById("copy-status") as HTMLElement;
    try {
      const res = await api("/api/admin/product", {
        method: "POST",
        body: JSON.stringify({
          section: "copy",
          tagline: (document.getElementById("copy-tagline") as HTMLInputElement).value,
          description: (document.getElementById("copy-description") as HTMLTextAreaElement).value,
        }),
      });
      const data = await res.json();
      if (res.ok) showHint(status, "Copy updated.", true);
      else showHint(status, data.error || "Failed to update.", false);
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  document.getElementById("recipe-save")?.addEventListener("click", async () => {
    const status = document.getElementById("recipe-status") as HTMLElement;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
    const materialCostCents = dollarsToCents(val("r-materialCost"));
    const labourRateCentsPerHour = dollarsToCents(val("r-labourRate"));
    const equipmentCostCents = dollarsToCents(val("r-equipmentCost"));
    const operationsOverheadCents = dollarsToCents(val("r-opsOverhead"));
    const marginCents = dollarsToCents(val("r-margin"));

    if (
      [materialCostCents, labourRateCentsPerHour, equipmentCostCents, operationsOverheadCents, marginCents].some(
        (v) => v === null,
      )
    ) {
      return showHint(status, "Check the dollar fields — one of them isn't a valid number.", false);
    }

    const recipe = {
      materialCostCents,
      materialWidthCm: Number(val("r-materialWidth")),
      materialHeightCm: Number(val("r-materialHeight")),
      materialWastePercent: Number(val("r-wastePercent")),
      tileSizeCm: Number(val("r-tileSize")),
      tilesPerKit: Number(val("r-tilesPerKit")),
      labourMinutes: Number(val("r-labourMinutes")),
      labourRateCentsPerHour,
      equipmentCostCents,
      operationsOverheadCents,
      givingTilesPerKit: Number(val("r-givingTiles")),
      marginCents,
    };

    try {
      const res = await api("/api/admin/product", {
        method: "POST",
        body: JSON.stringify({ section: "recipe", recipe }),
      });
      const data = await res.json();
      if (res.ok) {
        showHint(
          status,
          `Recalculated — cost ${money(data.costCalc.totalCostCents)}, new price ${money(data.product.basePriceCents)}.`,
          true,
        );
      } else {
        showHint(status, data.error || "Failed to recalculate.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  // --- Manual orders ---
  const moSendEmailCheckbox = document.getElementById("mo-send-email") as HTMLInputElement;
  const moEmailFields = document.getElementById("mo-email-fields") as HTMLDivElement;
  moSendEmailCheckbox?.addEventListener("change", () => {
    moEmailFields.hidden = !moSendEmailCheckbox.checked;
  });

  document.getElementById("mo-submit")?.addEventListener("click", async () => {
    const status = document.getElementById("mo-status") as HTMLElement;
    const btn = document.getElementById("mo-submit") as HTMLButtonElement;
    const email = (document.getElementById("mo-email") as HTMLInputElement).value.trim();
    const name = (document.getElementById("mo-name") as HTMLInputElement).value.trim();
    const type = (document.getElementById("mo-type") as HTMLSelectElement).value;
    const quantity = parseInt((document.getElementById("mo-quantity") as HTMLInputElement).value, 10);
    const priceStr = (document.getElementById("mo-price") as HTMLInputElement).value.trim();
    const deliveryMethod = (document.getElementById("mo-delivery") as HTMLSelectElement).value;
    const postcode = (document.getElementById("mo-postcode") as HTMLInputElement).value.trim();
    const deliveryFeeStr = (document.getElementById("mo-delivery-fee") as HTMLInputElement).value.trim();
    const paymentStatus = (document.getElementById("mo-payment-status") as HTMLSelectElement).value;
    const shipDate = (document.getElementById("mo-ship-date") as HTMLInputElement).value.trim();
    const note = (document.getElementById("mo-note") as HTMLInputElement).value.trim();
    const recipientName = (document.getElementById("mo-recipient") as HTMLInputElement).value.trim();
    const addressLine1 = (document.getElementById("mo-address1") as HTMLInputElement).value.trim();
    const addressLine2 = (document.getElementById("mo-address2") as HTMLInputElement).value.trim();
    const suburb = (document.getElementById("mo-suburb") as HTMLInputElement).value.trim();
    const state = (document.getElementById("mo-state") as HTMLInputElement).value.trim();
    const sendEmail = moSendEmailCheckbox.checked;
    const emailMessage = (document.getElementById("mo-email-message") as HTMLTextAreaElement).value.trim();
    const emailSignatureName = (document.getElementById("mo-email-sig-name") as HTMLInputElement).value.trim();
    const emailSignatureRole = (document.getElementById("mo-email-sig-role") as HTMLInputElement).value.trim();

    if (!email) return showHint(status, "Enter a customer email.", false);
    if (!Number.isFinite(quantity) || quantity < 1) return showHint(status, "Enter a valid quantity.", false);
    const unitPriceCents = priceStr ? dollarsToCents(priceStr) : undefined;
    if (priceStr && unitPriceCents === null) return showHint(status, "Price override isn't a valid number.", false);
    const deliveryFeeOverrideCents = deliveryFeeStr ? dollarsToCents(deliveryFeeStr) : undefined;
    if (deliveryFeeStr && deliveryFeeOverrideCents === null) return showHint(status, "Delivery fee override isn't a valid number.", false);
    if ((type === "COMMISSION" || type === "OTHER") && unitPriceCents === undefined) {
      if (!window.confirm("No price override set — this will default to the current retail price. Continue?")) {
        return;
      }
    }
    if ((deliveryMethod === "SELF_DELIVERY" || deliveryMethod === "AUSPOST") && !postcode && deliveryFeeOverrideCents === undefined) {
      if (!window.confirm("No postcode or delivery fee override set — this order will be charged $0 delivery. Continue?")) {
        return;
      }
    }
    if ((addressLine1 || suburb || state) && !(addressLine1 && suburb && state && postcode)) {
      if (!window.confirm("The shipping address looks incomplete (needs address line 1, suburb, state and postcode) — it won't be saved. Continue anyway?")) {
        return;
      }
    }

    btn.disabled = true;
    try {
      const res = await api("/api/admin/manual-order", {
        method: "POST",
        body: JSON.stringify({
          email,
          name: name || undefined,
          type,
          quantity,
          unitPriceCents: unitPriceCents ?? undefined,
          deliveryMethod,
          postcode: postcode || undefined,
          deliveryFeeOverrideCents: deliveryFeeOverrideCents ?? undefined,
          recipientName: recipientName || undefined,
          addressLine1: addressLine1 || undefined,
          addressLine2: addressLine2 || undefined,
          suburb: suburb || undefined,
          state: state || undefined,
          paymentStatus,
          expectedShipAtOverride: shipDate || undefined,
          note: note || undefined,
          sendEmail,
          emailMessage: sendEmail && emailMessage ? emailMessage : undefined,
          emailSignatureName: sendEmail && emailSignatureName ? emailSignatureName : undefined,
          emailSignatureRole: sendEmail && emailSignatureRole ? emailSignatureRole : undefined,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        showHint(
          status,
          `Order ${data.order.orderNumber} created${paymentStatus === "UNPAID" ? " as an unpaid quote." : "."} (delivery ${money(data.order.deliveryFeeCents, data.order.currency)})${sendEmail ? (data.emailSent ? " — confirmation emailed." : " — email failed to send.") : ""}`,
          true,
        );
        (document.getElementById("mo-email") as HTMLInputElement).value = "";
        (document.getElementById("mo-name") as HTMLInputElement).value = "";
        (document.getElementById("mo-type") as HTMLSelectElement).value = "DROP_SALE";
        (document.getElementById("mo-quantity") as HTMLInputElement).value = "1";
        (document.getElementById("mo-price") as HTMLInputElement).value = "";
        (document.getElementById("mo-postcode") as HTMLInputElement).value = "";
        (document.getElementById("mo-delivery-fee") as HTMLInputElement).value = "";
        (document.getElementById("mo-payment-status") as HTMLSelectElement).value = "PAID";
        (document.getElementById("mo-ship-date") as HTMLInputElement).value = "";
        (document.getElementById("mo-note") as HTMLInputElement).value = "";
        (document.getElementById("mo-recipient") as HTMLInputElement).value = "";
        (document.getElementById("mo-address1") as HTMLInputElement).value = "";
        (document.getElementById("mo-address2") as HTMLInputElement).value = "";
        (document.getElementById("mo-suburb") as HTMLInputElement).value = "";
        (document.getElementById("mo-state") as HTMLInputElement).value = "";
        moSendEmailCheckbox.checked = false;
        moEmailFields.hidden = true;
        (document.getElementById("mo-email-message") as HTMLTextAreaElement).value = "";
        (document.getElementById("mo-email-sig-name") as HTMLInputElement).value = "";
        (document.getElementById("mo-email-sig-role") as HTMLInputElement).value = "";
        loadOrders();
      } else {
        showHint(status, data.error || "Failed to create order.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    } finally {
      btn.disabled = false;
    }
  });

  // --- Email ---
  document.getElementById("email-goto-customers")?.addEventListener("click", () => activateTab("customers"));
  document.getElementById("email-goto-orders")?.addEventListener("click", () => activateTab("orders"));

  document.getElementById("email-send")?.addEventListener("click", async () => {
    const status = document.getElementById("email-status") as HTMLElement;
    const to = (document.getElementById("email-to") as HTMLTextAreaElement).value.trim();
    const subject = (document.getElementById("email-subject") as HTMLInputElement).value.trim();
    const message = (document.getElementById("email-message") as HTMLTextAreaElement).value.trim();
    const gifUrl = (document.getElementById("email-gif-url") as HTMLInputElement).value.trim();
    const signatureName = (document.getElementById("email-sig-name") as HTMLInputElement).value.trim();
    const signatureRole = (document.getElementById("email-sig-role") as HTMLInputElement).value.trim();
    if (!to || !subject || !message) return showHint(status, "Fill in all fields.", false);
    try {
      const res = await api("/api/admin/send-email", {
        method: "POST",
        body: JSON.stringify({
          mode: "custom",
          to,
          subject,
          message,
          gifUrl: gifUrl || undefined,
          signatureName: signatureName || undefined,
          signatureRole: signatureRole || undefined,
        }),
      });
      const data = await res.json();
      if (res.ok) {
        const parts = [`Sent to ${data.sent} recipient${data.sent === 1 ? "" : "s"}.`];
        if (data.failed?.length) parts.push(`${data.failed.length} failed: ${data.failed.map((f: any) => f.email).join(", ")}`);
        if (data.skippedInvalid?.length) parts.push(`Skipped invalid: ${data.skippedInvalid.join(", ")}`);
        showHint(status, parts.join(" "), !data.failed?.length && !data.skippedInvalid?.length);
      } else {
        showHint(status, data.error || "Failed to send.", false);
      }
    } catch {
      showHint(status, "Network error.", false);
    }
  });

  loadOrders();
</script>
</Layout>
