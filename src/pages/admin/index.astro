---
import Layout from "../../layouts/Layout.astro";

/**
 * Minimal admin dashboard — orders lookup/resend, pricing editor
 * (quick override + full cost-recipe recalculation), and a send-email
 * tool. All data comes from /api/admin/* (see api/admin/*.js), guarded by
 * the shared-password session cookie (src/lib/adminAuth.js). Every fetch
 * here treats a 401 as "not logged in" and bounces to /admin/login —
 * there's no server-rendered auth check on this page itself, since Astro's
 * static build has no per-request server to run one.
 */
---

<Layout
  title="Admin | Unstitch"
  noindex
  showNavbar={false}
  showTicker={false}
  showFooter={false}
>
  <main class="admin">
    <header class="admin__bar">
      <h1>Unstitch admin</h1>
      <button id="logout-btn" class="btn-ghost">Log out</button>
    </header>

    <nav class="admin__tabs">
      <button class="admin__tab is-active" data-tab="orders">Orders</button>
      <button class="admin__tab" data-tab="inventory">Inventory</button>
      <button class="admin__tab" data-tab="pricing">Pricing</button>
      <button class="admin__tab" data-tab="customers">Customers</button>
      <button class="admin__tab" data-tab="email">Send email</button>
    </nav>

    <p id="global-error" class="admin__error" hidden></p>

    <!-- ORDERS -->
    <section data-panel="orders" class="admin__panel">
      <div class="admin__panel-split">
        <div class="admin__orders-list">
          <div class="admin__panel-header">
            <h2>Recent orders</h2>
            <div class="admin__panel-header-actions">
              <button id="orders-email-selected" class="btn-primary btn-primary--small" hidden>Email 0 selected</button>
              <button id="orders-refresh" class="btn-ghost btn-ghost--small">Refresh</button>
            </div>
          </div>
          <table class="admin-table">
            <thead>
              <tr><th class="admin-table__checkbox-col"><input type="checkbox" id="orders-select-all" aria-label="Select all orders" /></th><th>Order</th><th>Customer</th><th>Type</th><th>Status</th><th>Total</th><th>Ship by</th><th>Date</th></tr>
            </thead>
            <tbody id="orders-tbody">
              <tr><td colspan="8" class="admin-table__empty">Loading…</td></tr>
            </tbody>
          </table>
        </div>

        <div class="admin__order-detail" id="order-detail" hidden>
          <div class="admin__panel-header">
            <h2>Order <span id="detail-number"></span></h2>
            <button id="detail-close" class="btn-ghost btn-ghost--small">Close</button>
          </div>
          <dl class="admin-kv" id="detail-summary"></dl>
          <div class="admin-field-row">
            <label for="detail-ship-date">Expected to ship by</label>
            <input id="detail-ship-date" type="date" />
            <button id="detail-ship-date-save" class="btn-ghost btn-ghost--small" type="button">Save</button>
          </div>
          <p id="ship-date-status" class="admin__hint" hidden></p>
          <h3>Items</h3>
          <ul id="detail-items" class="admin-list"></ul>
          <h3>Delivery address</h3>
          <p id="detail-address-empty-hint" class="admin-muted" hidden>No delivery address on file — fill in the fields below to add one.</p>
          <div class="admin-grid">
            <label>Recipient name<input id="detail-addr-recipient" type="text" /></label>
            <label>Address line 1<input id="detail-addr-line1" type="text" /></label>
            <label>Address line 2 <span class="admin-muted">(optional)</span><input id="detail-addr-line2" type="text" /></label>
            <label>Suburb<input id="detail-addr-suburb" type="text" /></label>
            <label>State<input id="detail-addr-state" type="text" /></label>
            <label>Postcode<input id="detail-addr-postcode" type="text" /></label>
          </div>
          <h3>Internal note <span class="admin-muted">(admin-only — never shown to the customer)</span></h3>
          <textarea id="detail-note" rows="2"></textarea>
          <button id="detail-order-save" class="btn-ghost btn-ghost--small" type="button">Save address &amp; note</button>
          <p id="order-details-status" class="admin__hint" hidden></p>
          <h3>Payments</h3>
          <ul id="detail-payments" class="admin-list"></ul>
          <div class="admin__actions">
            <button id="mark-paid" class="btn-primary" title="Records payment for this quote and moves it to Paid" hidden>Mark as paid</button>
            <button id="resend-confirmation" class="btn-primary" title="Emails the order confirmation again">Resend confirmation email</button>
            <button id="mark-shipped" class="btn-primary btn-primary--ship" title="Records today as the ship date">Mark as shipped</button>
            <button id="delete-test-order" class="btn-danger" title="Permanently deletes this order and reverts any numbered units it sold back to in-stock">Delete order (test data)</button>
          </div>
          <p id="paid-status" class="admin__hint" hidden></p>
          <p id="resend-status" class="admin__hint" hidden></p>
          <p id="ship-status" class="admin__hint" hidden></p>
          <p id="delete-order-status" class="admin__hint" hidden></p>
        </div>
      </div>

      <details class="admin-card admin-card--collapsible">
        <summary>+ Create a manual order <span class="admin-muted">(cash sale, gift, workshop giveaway, commission — not through Stripe)</span></summary>
        <div class="admin-manual-order">
          <div class="admin-grid">
            <label>Customer email<input id="mo-email" type="email" /></label>
            <label>Customer name (optional)<input id="mo-name" type="text" /></label>
            <label>Type
              <select id="mo-type">
                <option value="DROP_SALE">Drop sale — numbered kit from current stock</option>
                <option value="WORKSHOP">Workshop giveaway — numbered kit from current stock</option>
                <option value="COMMISSION">Commission — custom one-off, not from the drop</option>
                <option value="OTHER">Other</option>
              </select>
            </label>
            <label>Quantity<input id="mo-quantity" type="number" min="1" max="20" step="1" value="1" /></label>
            <label>Price override ($, optional)<input id="mo-price" type="number" step="0.01" min="0" placeholder="uses current retail price" /></label>
            <label>Delivery method
              <select id="mo-delivery">
                <option value="NONE">Not applicable / picked up</option>
                <option value="SELF_DELIVERY">Self-delivery</option>
                <option value="AUSPOST">Australia Post</option>
                <option value="PICKUP">Drop-box pickup</option>
              </select>
            </label>
            <label>Customer postcode <span class="admin-muted">(for Self-delivery/Australia Post fee, and part of the shipping address below)</span><input id="mo-postcode" type="text" inputmode="numeric" maxlength="10" placeholder="e.g. 3006" /></label>
            <label>Delivery fee override ($, optional) <span class="admin-muted">(for a larger/heavier piece)</span><input id="mo-delivery-fee" type="number" step="0.01" min="0" placeholder="uses resolved zone fee" /></label>
            <label>Payment status
              <select id="mo-payment-status">
                <option value="PAID">Paid — payment already received</option>
                <option value="UNPAID">Quote issued — not paid yet</option>
              </select>
            </label>
            <label>Expected ship date <span class="admin-muted">(optional — leave blank to auto-calculate; min 5 business days out)</span><input id="mo-ship-date" type="date" /></label>
            <label>Note (internal only, optional)<input id="mo-note" type="text" maxlength="500" /></label>
          </div>

          <h3 class="admin-manual-order__subheading">Shipping address <span class="admin-muted">(optional — needed to show "Shipping to" on the order and in the confirmation email)</span></h3>
          <div class="admin-grid">
            <label>Recipient name<input id="mo-recipient" type="text" placeholder="defaults to customer name/email" /></label>
            <label>Address line 1<input id="mo-address1" type="text" /></label>
            <label>Address line 2 (optional)<input id="mo-address2" type="text" /></label>
            <label>Suburb<input id="mo-suburb" type="text" /></label>
            <label>State<input id="mo-state" type="text" maxlength="10" placeholder="VIC" /></label>
          </div>

          <label class="admin-checkbox-label"><input id="mo-send-email" type="checkbox" /> Email the customer a confirmation</label>
          <div id="mo-email-fields" hidden>
            <label for="mo-email-message">Message <span class="admin-muted">(optional — leave blank for the standard "made to order" note)</span></label>
            <textarea id="mo-email-message" rows="4" maxlength="10000"></textarea>
            <div class="admin-grid">
              <label>Sign as <span class="admin-muted">(optional — defaults to Astra)</span><input id="mo-email-sig-name" type="text" placeholder="Astra" /></label>
              <label>Their role <span class="admin-muted">(optional — defaults to Designer at Unstitch)</span><input id="mo-email-sig-role" type="text" placeholder="Designer at Unstitch" /></label>
            </div>
          </div>

          <button id="mo-submit" class="btn-primary">Create order</button>
          <p id="mo-status" class="admin__hint" hidden></p>
        </div>
      </details>
    </section>

    <!-- INVENTORY -->
    <section data-panel="inventory" class="admin__panel" hidden>
      <p id="inventory-loading">Loading drops…</p>
      <div id="inventory-content" hidden></div>
    </section>

    <!-- PRICING -->
    <section data-panel="pricing" class="admin__panel" hidden>
      <p id="pricing-loading">Loading product…</p>

      <div id="pricing-content" hidden>
        <div class="admin-card">
          <h2>Quick price override</h2>
          <p class="admin-muted">Sets the retail price directly — no recalculation, no change to the cost recipe below.</p>
          <div class="admin-field-row">
            <label for="price-override">Price (AUD)</label>
            <input id="price-override" type="number" step="0.01" min="0" />
            <button id="price-save" class="btn-primary">Save price</button>
          </div>
          <p id="price-status" class="admin__hint" hidden></p>
        </div>

        <div class="admin-card">
          <h2>Product copy</h2>
          <label for="copy-tagline">Tagline</label>
          <input id="copy-tagline" type="text" maxlength="280" />
          <label for="copy-description">Description</label>
          <textarea id="copy-description" rows="4"></textarea>
          <button id="copy-save" class="btn-primary">Save copy</button>
          <p id="copy-status" class="admin__hint" hidden></p>
        </div>

        <div class="admin-card">
          <h2>Cost recipe</h2>
          <p class="admin-muted">
            Recalculates the full per-kit cost breakdown from these inputs (same formula as the original seed data)
            and sets the retail price to cost + margin, rounded up to the nearest 50c.
          </p>
          <div class="admin-grid">
            <label>Material cost ($)<input id="r-materialCost" type="number" step="0.01" min="0" /></label>
            <label>Material width (cm)<input id="r-materialWidth" type="number" step="1" min="1" /></label>
            <label>Material height (cm)<input id="r-materialHeight" type="number" step="1" min="1" /></label>
            <label>Material waste (%)<input id="r-wastePercent" type="number" step="1" min="0" max="100" /></label>
            <label>Tile size (cm)
              <select id="r-tileSize">
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">10</option>
                <option value="11">11</option>
              </select>
            </label>
            <label>Tiles per kit<input id="r-tilesPerKit" type="number" step="1" min="1" /></label>
            <label>Labour (minutes)<input id="r-labourMinutes" type="number" step="1" min="0" /></label>
            <label>Labour rate ($/hr)<input id="r-labourRate" type="number" step="0.01" min="0" /></label>
            <label>Equipment cost ($)<input id="r-equipmentCost" type="number" step="0.01" min="0" /></label>
            <label>Operations overhead ($)<input id="r-opsOverhead" type="number" step="0.01" min="0" /></label>
            <label>Giving tiles per kit<input id="r-givingTiles" type="number" step="1" min="0" /></label>
            <label>Margin ($)<input id="r-margin" type="number" step="0.01" /></label>
          </div>
          <button id="recipe-save" class="btn-primary">Recalculate &amp; save</button>
          <p id="recipe-status" class="admin__hint" hidden></p>
        </div>
      </div>
    </section>

    <!-- CUSTOMERS -->
    <section data-panel="customers" class="admin__panel" hidden>
      <div class="admin__panel-header">
        <h2>Customers</h2>
        <div class="admin__panel-header-actions">
          <button id="customers-email-selected" class="btn-primary btn-primary--small" hidden>Email 0 selected</button>
          <button id="customers-refresh" class="btn-ghost btn-ghost--small">Refresh</button>
        </div>
      </div>
      <table class="admin-table">
        <thead>
          <tr><th class="admin-table__checkbox-col"><input type="checkbox" id="customers-select-all" aria-label="Select all customers" /></th><th>Email</th><th>Name</th><th>Orders</th><th>Total spent</th><th>Joined</th></tr>
        </thead>
        <tbody id="customers-tbody">
          <tr><td colspan="6" class="admin-table__empty">Loading…</td></tr>
        </tbody>
      </table>

      <div class="admin__order-detail" id="customer-detail" hidden>
        <div class="admin__panel-header">
          <h2>Edit customer</h2>
          <button id="customer-detail-close" class="btn-ghost btn-ghost--small">Close</button>
        </div>
        <p class="admin-muted">Changes here only affect the customer record — past orders keep the details that were on them at the time.</p>
        <div class="admin-grid">
          <label>Email<input id="cd-email" type="email" /></label>
          <label>Name<input id="cd-name" type="text" /></label>
          <label>Phone<input id="cd-phone" type="text" /></label>
        </div>
        <button id="customer-detail-save" class="btn-primary">Save changes</button>
        <p id="customer-detail-status" class="admin__hint" hidden></p>
      </div>
    </section>

    <section data-panel="email" class="admin__panel" hidden>
      <div class="admin-card">
        <h2>Send a custom email</h2>
        <label for="email-to">To <span class="admin-muted">(comma or newline-separated — sent individually, never CC'd together)</span></label>
        <textarea id="email-to" rows="2" placeholder="one@example.com, two@example.com"></textarea>
        <p class="admin-muted">Or check recipients from the <button type="button" id="email-goto-customers" class="admin-link-btn">Customers</button> or <button type="button" id="email-goto-orders" class="admin-link-btn">Orders</button> tab.</p>
        <label for="email-subject">Subject</label>
        <input id="email-subject" type="text" maxlength="200" />
        <label for="email-message">Message</label>
        <textarea id="email-message" rows="6" maxlength="10000"></textarea>
        <p class="admin-muted">Your sign-off (Astra — Designer at Unstitch, with website/LinkedIn/Instagram) is added automatically. Sends as a branded HTML email, with a plain-text fallback.</p>
        <label for="email-gif-url">Sign-off gif URL <span class="admin-muted">(optional — e.g. for a workshop or new-contact welcome note)</span></label>
        <input id="email-gif-url" type="url" placeholder="https://unstitchx.com/…/welcome.gif" />
        <div class="admin-grid">
          <label>Sign as <span class="admin-muted">(optional — defaults to Astra)</span><input id="email-sig-name" type="text" placeholder="Astra" /></label>
          <label>Their role <span class="admin-muted">(optional — defaults to Designer at Unstitch)</span><input id="email-sig-role" type="text" placeholder="Designer at Unstitch" /></label>
        </div>
        <button id="email-send" class="btn-primary">Send</button>
        <p id="email-status" class="admin__hint" hidden></p>
      </div>
    </section>

  </main>

<style is:global>
  .admin {
    max-width: 960px;
    margin: 0 auto;
    padding: 28px 20px 80px;
    font-family: system-ui, -apple-system, sans-serif;
    color: #1a1a1a;
  }
  .admin__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .admin__bar h1 { font-size: 1.2rem; margin: 0; }
  .admin__tabs { display: flex; gap: 8px; border-bottom: 1px solid #ddd; margin-bottom: 20px; }
  .admin__tab {
    background: none; border: none; padding: 10px 14px; font-size: 0.9rem;
    cursor: pointer; color: #666; border-bottom: 2px solid transparent;
  }
  .admin__tab.is-active { color: #1a1a1a; border-bottom-color: #1a1a1a; font-weight: 600; }
  .admin__error {
    background: #fdecea; color: #b3261e; border: 1px solid #f3c8c4;
    padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem;
  }
  .admin__panel-split { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 860px) {
    .admin__panel-split { grid-template-columns: 1.1fr 0.9fr; align-items: start; }
  }
  .admin__panel-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .admin__panel-header h2 { font-size: 1rem; margin: 0; }
  .admin__panel-header-actions { display: flex; align-items: center; gap: 8px; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .admin-table th { text-align: left; padding: 8px 6px; color: #777; font-weight: 500; border-bottom: 1px solid #ddd; }
  .admin-table td { padding: 8px 6px; border-bottom: 1px solid #eee; }
  .admin-table tr[data-order-row] { cursor: pointer; }
  .admin-table tr[data-order-row]:hover { background: #f7f6f3; }
  .admin-table tr[data-customer-row] { cursor: pointer; }
  .admin-table tr[data-customer-row]:hover { background: #f7f6f3; }
  .admin-table__checkbox-col { width: 28px; }
  .btn-primary--small { padding: 4px 10px; font-size: 0.78rem; }
  .admin-link-btn {
    background: none; border: none; padding: 0; font: inherit; color: var(--accent, #1a1a1a);
    text-decoration: underline; cursor: pointer;
  }
  .admin-table__empty { color: #888; text-align: center; padding: 20px !important; }
  .admin__order-detail { background: #fff; border: 1px solid #e2e0db; border-radius: 10px; padding: 18px; }
  .admin-kv { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 0.88rem; margin: 0 0 14px; }
  .admin-kv dt { color: #777; }
  .admin-kv dd { margin: 0; }
  .admin-list { list-style: none; padding: 0; margin: 0 0 14px; font-size: 0.88rem; }
  .admin-list li { padding: 6px 0; border-bottom: 1px solid #eee; }
  .admin-list--inline { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .admin-list--inline li { border-bottom: none; padding: 0; font-size: 0.85rem; }
  .admin-muted { color: #777; font-size: 0.85rem; }
  .admin-card {
    background: #fff; border: 1px solid #e2e0db; border-radius: 10px;
    padding: 20px; margin-bottom: 20px;
  }
  .admin-card h2 { font-size: 1rem; margin: 0 0 6px; }
  .admin-card label { display: block; font-size: 0.82rem; color: #555; margin: 10px 0 4px; }
  .admin-card input, .admin-card textarea, .admin-card select {
    width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 0.9rem;
    box-sizing: border-box; font-family: inherit;
  }
  .admin-field-row { display: flex; align-items: flex-end; gap: 10px; }
  .admin-field-row label { flex: 0 0 auto; }
  .admin-field-row input { width: 140px; }
  .admin-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 16px; }
  @media (min-width: 620px) {
    .admin-grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* --- Buttons: every actionable button gets a visible hover/active state
     and a colour that signals what it does (black = normal action, red =
     destructive/removes something, outlined = secondary/toggle). --- */
  .btn-primary {
    margin-top: 14px; padding: 9px 16px; border: 1px solid #1a1a1a; border-radius: 6px;
    background: #1a1a1a; color: #fff; font-size: 0.88rem; font-weight: 600; cursor: pointer;
    transition: background-color 0.12s ease, transform 0.05s ease;
  }
  .btn-primary:hover:not(:disabled) { background: #3a3a3a; }
  .btn-primary:active:not(:disabled) { transform: translateY(1px); }
  .btn-primary:focus-visible { outline: 2px solid #1a1a1a; outline-offset: 2px; }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-primary--ship { background: #1a5f3f; border-color: #1a5f3f; }
  .btn-primary--ship:hover:not(:disabled) { background: #227a51; }
  .btn-danger {
    margin-top: 14px; padding: 9px 16px; border: 1px solid #b3261e; border-radius: 6px;
    background: #fff; color: #b3261e; font-size: 0.88rem; font-weight: 600; cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease, transform 0.05s ease;
  }
  .btn-danger:hover:not(:disabled) { background: #b3261e; color: #fff; }
  .btn-danger:active:not(:disabled) { transform: translateY(1px); }
  .btn-danger:focus-visible { outline: 2px solid #b3261e; outline-offset: 2px; }
  .btn-danger:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-ghost {
    background: none; border: 1px solid #ccc; border-radius: 6px; padding: 7px 12px;
    font-size: 0.85rem; cursor: pointer; color: #333; transition: background-color 0.12s ease, border-color 0.12s ease;
  }
  .btn-ghost:hover:not(:disabled) { background: #f2f1ee; border-color: #999; }
  .btn-ghost:focus-visible { outline: 2px solid #1a1a1a; outline-offset: 2px; }
  .btn-ghost--small { padding: 4px 10px; font-size: 0.78rem; }
  .admin__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .admin__hint { font-size: 0.82rem; margin-top: 8px; }
  .admin__hint.is-success { color: #1a7f37; }
  .admin__hint.is-error { color: #b3261e; }

  /* --- Manual order --- */
  .admin-card--collapsible { cursor: default; }
  .admin-card--collapsible > summary {
    cursor: pointer; font-weight: 600; font-size: 0.92rem; list-style: none;
  }
  .admin-card--collapsible > summary::-webkit-details-marker { display: none; }
  .admin-manual-order { margin-top: 14px; }
  .admin-manual-order__subheading { font-size: 0.88rem; margin: 18px 0 4px; font-weight: 600; }
  .admin-checkbox-label {
    display: flex; align-items: center; gap: 6px; font-size: 0.85rem;
    color: #333; margin: 16px 0 6px; cursor: pointer;
  }
  .admin-checkbox-label input { width: auto; margin: 0; }

  /* --- Inventory: drop cards --- */
  .admin-drop-card { display: flex; gap: 16px; }
  .admin-drop-photo {
    width: 72px; height: 72px; flex: 0 0 auto; border-radius: 8px; object-fit: cover;
    background: #f2f1ee; border: 1px solid #e2e0db;
  }
  .admin-drop-body { flex: 1 1 auto; min-width: 0; }
  .admin-drop-code {
    display: inline-block; font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.8rem; font-weight: 700; background: #1a1a1a; color: #fff;
    padding: 2px 8px; border-radius: 4px; letter-spacing: 0.02em; margin-left: 8px;
    vertical-align: middle;
  }
  .admin-status-chip {
    display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 0.76rem;
    background: #eee; color: #444; border: 1px solid #ddd;
  }
  .admin-status-chip[data-status="IN_STOCK"] { background: #e7f4ec; color: #1a5f3f; border-color: #bfe3cc; }
  .admin-status-chip[data-status="RESERVED"] { background: #fff6e0; color: #8a6d1a; border-color: #f0dfa3; }
  .admin-status-chip[data-status="SOLD"], .admin-status-chip[data-status="SHIPPED"], .admin-status-chip[data-status="DELIVERED"] {
    background: #e8eefc; color: #2b4c9b; border-color: #c7d5f5;
  }
  .admin-status-chip[data-status="VOID"] { background: #f5eaea; color: #8a3a3a; border-color: #e6c9c9; text-decoration: line-through; }
  .admin-flag {
    display: inline-block; font-size: 0.72rem; font-weight: 700; color: #8a3a1a;
    background: #fdece0; border: 1px solid #f0c9a8; border-radius: 4px;
    padding: 1px 6px; margin-left: 6px; vertical-align: middle; cursor: help;
  }
  .admin-flag--muted { color: #666; background: #f2f2f2; border-color: #ddd; font-weight: 400; }
  .admin-shipby--overdue { color: #a33a3a; font-weight: 700; }
  .admin-units-toggle {
    background: none; border: none; padding: 4px 0; font-size: 0.82rem; color: #555;
    text-decoration: underline; cursor: pointer; margin-top: 6px;
  }
  .admin-units-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 8px; }
  .admin-units-table th { text-align: left; padding: 4px 6px; color: #888; font-weight: 500; }
  .admin-units-table td { padding: 4px 6px; border-top: 1px solid #eee; }
  .admin-restock-row { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
  .admin-restock-row .admin-field-row { margin-right: 4px; }
</style>

<script>
  import { esc } from "../../lib/emailTemplate.js";

  type OrderSummary = {
    id: string;
    orderNumber: string;
    status: string;
    totalCents: number;
    currency: string;
    createdAt: string;
    expectedShipAt?: string | null;
    shippedAt?: string | null;
    internalNote?: string | null;
    customer: { email: string; name: string | null };
  };

  function orderTypeLabel(note: string | null | undefined): string {
    if (!note) return "—";
    const match = note.match(/^\[(Drop sale|Workshop|Commission|Other)\]/);
    return match ? match[1] : "—";
  }

  type CustomerSummary = {
    id: string;
    email: string;
    name: string | null;
    createdAt: string;
    orderCount: number;
    totalSpentCents: number;
  };

  // Selection state for the bulk-email workflow — shared across the Orders
  // and Customers tabs so either one can hand its picks to the Send Email
  // tab. Keyed by order id / customer email respectively; emails are the
  // natural key for customers since that's what a send ultimately needs.
  const selectedOrderIds = new Set<string>();
  const orderEmailsById = new Map<string, string>();
  const selectedCustomerEmails = new Set<string>();

  function updateOrdersEmailButton() {
    const btn = document.getElementById("orders-email-selected") as HTMLButtonElement;
    btn.hidden = selectedOrderIds.size === 0;
    btn.textContent = `Email ${selectedOrderIds.size} selected`;
  }

  function updateCustomersEmailButton() {
    const btn = document.getElementById("customers-email-selected") as HTMLButtonElement;
    btn.hidden = selectedCustomerEmails.size === 0;
    btn.textContent = `Email ${selectedCustomerEmails.size} selected`;
  }

  function money(cents: number, currency = "AUD") {
    return `${currency} $${(cents / 100).toFixed(2)}`;
  }

  function dollarsToCents(value: string): number | null {
    const n = Number(value);
    if (!Number.isFinite(n)) return null;
    return Math.round(n * 100);
  }

  function centsToDollarsStr(cents: number): string {
    return (cents / 100).toFixed(2);
  }

  async function api(path: string, options: RequestInit = {}) {
    const res = await fetch(path, {
      ...options,
      headers: { "Content-Type": "application/json", ...(options.headers || {}) },
      credentials: "same-origin",
    });
    if (res.status === 401) {
      window.location.href = "/admin/login";
      throw new Error("Not authenticated");
    }
    return res;
  }

  function showHint(el: HTMLElement, message: string, ok: boolean) {
    el.textContent = message;
    el.hidden = false;
    el.classList.toggle("is-success", ok);
    el.classList.toggle("is-error", !ok);
  }

  function showGlobalError(message: string) {
    const el = document.getElementById("global-error") as HTMLParagraphElement;
    el.textContent = message;
    el.hidden = false;
  }

  // --- Tabs ---
  function activateTab(target: string) {
    document.querySelectorAll<HTMLButtonElement>(".admin__tab").forEach((t) => {
      t.classList.toggle("is-active", t.dataset.tab === target);
    });
    document.querySelectorAll<HTMLElement>(".admin__panel").forEach((panel) => {
      panel.hidden = panel.dataset.panel !== target;
    });
    if (target === "pricing") loadProduct();
    if (target === "inventory") loadInventory();
    if (target === "customers") loadCustomers();
  }
  document.querySelectorAll<HTMLButtonElement>(".admin__tab").forEach((tab) => {
    tab.addEventListener("click", () => activateTab(tab.dataset.tab as string));
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" }).catch(() => {});
    window.location.href = "/admin/login";
  });

  // --- Orders ---
  // Renders one order table row. Extracted from loadOrders() so both the
  // full-list render and a single-row patch (after mark-paid/mark-shipped/
  // update-ship-date/update-order-details, see patchOrderRow below) share
  // exactly one implementation. Every interpolated value is passed through
  // esc() — this function must be XSS-safe standing on its own, since a
  // customer-supplied value (billing/order name) can flow into o.customer
  // via Stripe checkout.
  function renderOrderRow(o: OrderSummary): string {
    const noteTitle = o.internalNote ? esc(o.internalNote) : "";
    const noteFlag = o.internalNote?.includes("⚠️")
      ? ` <span class="admin-flag" title="${noteTitle}">⚠️ review</span>`
      : o.internalNote
        ? ` <span class="admin-flag admin-flag--muted" title="${noteTitle}">📝</span>`
        : "";
    const overdue = !o.shippedAt && o.expectedShipAt && new Date(o.expectedShipAt).getTime() <= Date.now();
    const shipByCell = o.shippedAt
      ? `Shipped ${esc(new Date(o.shippedAt).toLocaleDateString())}`
      : o.expectedShipAt
        ? `<span class="${overdue ? "admin-shipby--overdue" : ""}">${overdue ? "Overdue — " : ""}${esc(new Date(o.expectedShipAt).toLocaleDateString())}</span>`
        : "—";
    const id = esc(o.id);
    return `
        <tr data-order-row data-id="${id}">
          <td class="admin-table__checkbox-col" data-checkbox-cell><input type="checkbox" class="order-select-checkbox" data-order-id="${id}" aria-label="Select order ${esc(o.orderNumber)}" /></td>
          <td>${esc(o.orderNumber)}${noteFlag}</td>
          <td>${esc(o.customer?.name || o.customer?.email || "—")}</td>
          <td>${esc(orderTypeLabel(o.internalNote))}</td>
          <td>${esc(o.status)}</td>
          <td>${esc(money(o.totalCents, o.currency))}</td>
          <td>${shipByCell}</td>
          <td>${esc(new Date(o.createdAt).toLocaleDateString())}</td>
        </tr>`;
  }

  // Attaches the row-click and checkbox listeners to one already-rendered
  // <tr data-order-row>. Shared between the full-list render (one pass over
  // every row) and a single-row patch (just the replaced row) so a patched
  // row never ends up without its click/select behaviour.
  function bindOrderRow(row: HTMLTableRowElement, tbody: HTMLTableSectionElement) {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-checkbox-cell]")) return;
      openOrderDetail(row.dataset.id as string);
    });
    const cb = row.querySelector<HTMLInputElement>(".order-select-checkbox");
    if (!cb) return;
    cb.checked = selectedOrderIds.has(cb.dataset.orderId as string);
    cb.addEventListener("click", (e) => e.stopPropagation());
    cb.addEventListener("change", () => {
      const id = cb.dataset.orderId as string;
      if (cb.checked) selectedOrderIds.add(id);
      else selectedOrderIds.delete(id);
      updateOrdersEmailButton();
      const all = tbody.querySelectorAll<HTMLInputElement>(".order-select-checkbox");
      const selectAll = document.getElementById("orders-select-all") as HTMLInputElement;
      selectAll.checked = all.length > 0 && tbody.querySelectorAll(".order-select-checkbox:checked").length === all.length;
    });
  }

  async function loadOrders() {
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    try {
      const res = await api("/api/admin/orders");
      if (!res.ok) throw new Error("Failed to load orders");
      const { orders } = (await res.json()) as { orders: OrderSummary[] };
      orderEmailsById.clear();
      if (orders.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="admin-table__empty">No orders yet.</td></tr>`;
        updateOrdersEmailButton();
        return;
      }
      orders.forEach((o) => orderEmailsById.set(o.id, o.customer?.email || ""));
      tbody.innerHTML = orders.map(renderOrderRow).join("");
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-order-row]").forEach((row) => bindOrderRow(row, tbody));
      updateOrdersEmailButton();
    } catch {
      tbody.innerHTML = `<tr><td colspan="8" class="admin-table__empty">Couldn't load orders.</td></tr>`;
    }
  }

  // Replaces exactly the one row for updatedOrder in place, instead of the
  // full 200-row loadOrders() refetch + tbody rebuild the four order-detail
  // actions used to trigger. Falls back to a full loadOrders() only if the
  // row can't be found (e.g. it scrolled out of the currently-loaded list),
  // so behaviour degrades safely rather than silently doing nothing.
  function patchOrderRow(updatedOrder: OrderSummary) {
    orderEmailsById.set(updatedOrder.id, updatedOrder.customer?.email || "");
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    const existingRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-order-row][data-id="${CSS.escape(updatedOrder.id)}"]`);
    if (!existingRow) {
      loadOrders();
      return;
    }
    existingRow.outerHTML = renderOrderRow(updatedOrder);
    const newRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-order-row][data-id="${CSS.escape(updatedOrder.id)}"]`);
    if (newRow) bindOrderRow(newRow, tbody);
  }

  document.getElementById("orders-select-all")?.addEventListener("change", (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    const tbody = document.getElementById("orders-tbody") as HTMLTableSectionElement;
    tbody.querySelectorAll<HTMLInputElement>(".order-select-checkbox").forEach((cb) => {
      cb.checked = checked;
      const id = cb.dataset.orderId as string;
      if (checked) selectedOrderIds.add(id);
      else selectedOrderIds.delete(id);
    });
    updateOrdersEmailButton();
  });

  document.getElementById("orders-email-selected")?.addEventListener("click", () => {
    const emails = Array.from(selectedOrderIds)
      .map((id) => orderEmailsById.get(id))
      .filter((e): e is string => !!e);
    const unique = Array.from(new Set(emails));
    (document.getElementById("email-to") as HTMLTextAreaElement).value = unique.join("\n");
    activateTab("email");
  });

  async function openOrderDetail(id: string) {
    const detail = document.getElementById("order-detail") as HTMLDivElement;
    try {
      const res = await api(`/api/admin/orders?id=${encodeURIComponent(id)}`);
      if (!res.ok) throw new Error("not found");
      const { order } = await res.json();
      detail.hidden = false;
      (document.getElementById("detail-number") as HTMLElement).textContent = order.orderNumber;
      (document.getElementById("detail-summary") as HTMLElement).innerHTML = `
        <dt>Customer</dt><dd>${esc(order.customer.email)}${order.customer.name ? ` (${esc(order.customer.name)})` : ""}</dd>
        <dt>Status</dt><dd>${order.status}</dd>
        <dt>Total</dt><dd>${money(order.totalCents, order.currency)}</dd>
        <dt>Placed</dt><dd>${new Date(order.createdAt).toLocaleString()}</dd>
        <dt>Shipped</dt><dd>${order.shippedAt ? new Date(order.shippedAt).toLocaleString() : "Not yet"}</dd>
      `;
      (document.getElementById("detail-items") as HTMLElement).innerHTML = order.items
        .map(
          (it: any) =>
            `<li>${it.quantity} × ${esc(it.product?.name || "Item")}${it.unit?.serial ? ` — unit ${esc(it.unit.serial)}` : ""} — ${money(it.lineTotalCents, order.currency)}</li>`,
        )
        .join("") || "<li>No items</li>";
      const addr = order.deliveryAddress;
      (document.getElementById("detail-address-empty-hint") as HTMLElement).hidden = !!addr;
      (document.getElementById("detail-addr-recipient") as HTMLInputElement).value = addr?.recipientName || "";
      (document.getElementById("detail-addr-line1") as HTMLInputElement).value = addr?.line1 || "";
      (document.getElementById("detail-addr-line2") as HTMLInputElement).value = addr?.line2 || "";
      (document.getElementById("detail-addr-suburb") as HTMLInputElement).value = addr?.suburb || "";
      (document.getElementById("detail-addr-state") as HTMLInputElement).value = addr?.state || "";
      (document.getElementById("detail-addr-postcode") as HTMLInputElement).value = addr?.postcode || "";
      (document.getElementById("detail-note") as HTMLTextAreaElement).value = order.internalNote || "";

      const orderSaveBtn = document.getElementById("detail-order-save") as HTMLButtonElement;
      const orderSaveStatus = document.getElementById("order-details-status") as HTMLElement;
      orderSaveStatus.hidden = true;
      orderSaveBtn.onclick = async () => {
        orderSaveBtn.disabled = true;
        orderSaveStatus.hidden = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({
              action: "update-order-details",
              orderId: order.id,
              recipientName: (document.getElementById("detail-addr-recipient") as HTMLInputElement).value.trim(),
              addressLine1: (document.getElementById("detail-addr-line1") as HTMLInputElement).value.trim(),
              addressLine2: (document.getElementById("detail-addr-line2") as HTMLInputElement).value.trim(),
              suburb: (document.getElementById("detail-addr-suburb") as HTMLInputElement).value.trim(),
              state: (document.getElementById("detail-addr-state") as HTMLInputElement).value.trim(),
              postcode: (document.getElementById("detail-addr-postcode") as HTMLInputElement).value.trim(),
              internalNote: (document.getElementById("detail-note") as HTMLTextAreaElement).value.trim(),
            }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(orderSaveStatus, "Saved.", true);
            patchOrderRow(data.order);
          } else {
            showHint(orderSaveStatus, data.error || "Failed to save.", false);
          }
        } catch {
          showHint(orderSaveStatus, "Network error.", false);
        } finally {
          orderSaveBtn.disabled = false;
        }
      };

      (document.getElementById("detail-payments") as HTMLElement).innerHTML =
        order.payments
          .map((p: any) => `<li>${esc(p.provider)} — ${esc(p.status)} — ${money(p.amountCents, order.currency)}</li>`)
          .join("") || "<li>No payments recorded</li>";

      const shipDateInput = document.getElementById("detail-ship-date") as HTMLInputElement;
      const shipDateSaveBtn = document.getElementById("detail-ship-date-save") as HTMLButtonElement;
      const shipDateStatus = document.getElementById("ship-date-status") as HTMLElement;
      shipDateStatus.hidden = true;
      shipDateInput.value = order.expectedShipAt ? new Date(order.expectedShipAt).toISOString().slice(0, 10) : "";
      shipDateSaveBtn.onclick = async () => {
        const value = shipDateInput.value;
        if (!value) {
          showHint(shipDateStatus, "Pick a date first.", false);
          return;
        }
        shipDateSaveBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "update-ship-date", orderId: order.id, expectedShipAt: value }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(shipDateStatus, "Ship-by date updated.", true);
            patchOrderRow(data.order);
          } else {
            showHint(shipDateStatus, data.error || "Failed to update.", false);
          }
        } catch {
          showHint(shipDateStatus, "Network error.", false);
        } finally {
          shipDateSaveBtn.disabled = false;
        }
      };

      const paidBtn = document.getElementById("mark-paid") as HTMLButtonElement;
      const paidStatus = document.getElementById("paid-status") as HTMLElement;
      paidStatus.hidden = true;
      paidBtn.hidden = order.status !== "PENDING_PAYMENT";
      paidBtn.onclick = async () => {
        paidBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "mark-paid", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(paidStatus, "Marked as paid.", true);
            paidBtn.hidden = true;
            openOrderDetail(order.id);
            patchOrderRow(data.order);
          } else {
            showHint(paidStatus, data.error || "Failed to update.", false);
            paidBtn.disabled = false;
          }
        } catch {
          showHint(paidStatus, "Network error.", false);
          paidBtn.disabled = false;
        }
      };

      const resendBtn = document.getElementById("resend-confirmation") as HTMLButtonElement;
      const resendStatus = document.getElementById("resend-status") as HTMLElement;
      resendStatus.hidden = true;
      resendBtn.onclick = async () => {
        resendBtn.disabled = true;
        try {
          const r = await api("/api/admin/send-email", {
            method: "POST",
            body: JSON.stringify({ mode: "resend-confirmation", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) showHint(resendStatus, "Confirmation email sent.", true);
          else showHint(resendStatus, data.error || "Failed to send.", false);
        } catch {
          showHint(resendStatus, "Network error.", false);
        } finally {
          resendBtn.disabled = false;
        }
      };

      const shipBtn = document.getElementById("mark-shipped") as HTMLButtonElement;
      const shipStatus = document.getElementById("ship-status") as HTMLElement;
      shipStatus.hidden = true;
      shipBtn.disabled = !!order.shippedAt;
      shipBtn.textContent = order.shippedAt ? "Already marked shipped" : "Mark as shipped";
      shipBtn.onclick = async () => {
        shipBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "mark-shipped", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(shipStatus, "Marked as shipped.", true);
            shipBtn.textContent = "Already marked shipped";
            openOrderDetail(order.id);
            patchOrderRow(data.order);
          } else {
            showHint(shipStatus, data.error || "Failed to update.", false);
            shipBtn.disabled = false;
          }
        } catch {
          showHint(shipStatus, "Network error.", false);
          shipBtn.disabled = false;
        }
      };

      const deleteBtn = document.getElementById("delete-test-order") as HTMLButtonElement;
      const deleteStatus = document.getElementById("delete-order-status") as HTMLElement;
      deleteStatus.hidden = true;
      deleteBtn.onclick = async () => {
        const warning = order.shippedAt
          ? `Order ${order.orderNumber} has already been marked shipped — this permanently deletes it and puts any numbered unit(s) it sold back IN_STOCK as if never sold. This cannot be undone. Continue?`
          : `Permanently delete order ${order.orderNumber} and put any numbered unit(s) it sold back IN_STOCK as if never sold? This cannot be undone.`;
        if (!window.confirm(warning)) return;
        deleteBtn.disabled = true;
        try {
          const r = await api("/api/admin/orders", {
            method: "POST",
            body: JSON.stringify({ action: "delete-test-order", orderId: order.id }),
          });
          const data = await r.json();
          if (r.ok) {
            (document.getElementById("order-detail") as HTMLDivElement).hidden = true;
            loadOrders();
          } else {
            showHint(deleteStatus, data.error || "Failed to delete.", false);
            deleteBtn.disabled = false;
          }
        } catch {
          showHint(deleteStatus, "Network error.", false);
          deleteBtn.disabled = false;
        }
      };
    } catch {
      showGlobalError("Couldn't load that order.");
    }
  }

  document.getElementById("detail-close")?.addEventListener("click", () => {
    (document.getElementById("order-detail") as HTMLDivElement).hidden = true;
  });
  document.getElementById("orders-refresh")?.addEventListener("click", loadOrders);

  // --- Customers ---
  // Cache of the currently-rendered customer list, keyed by id. Lets a
  // single-row patch (see patchCustomerRow below) carry forward orderCount/
  // totalSpentCents — derived aggregates the customer-edit endpoint doesn't
  // (and shouldn't) recompute — while still reflecting the freshly-saved
  // email/name/createdAt.
  const customersCache = new Map<string, CustomerSummary>();

  // Renders one customer table row. Extracted from loadCustomers() so both
  // the full-list render and a single-row patch (after saving the customer-
  // detail form) share one implementation. Every interpolated value is
  // passed through esc() — this function must be XSS-safe standing on its
  // own, since name/email ultimately trace back to customer-supplied input
  // (Stripe checkout billing details).
  function renderCustomerRow(c: CustomerSummary): string {
    const email = esc(c.email);
    return `
        <tr data-customer-row data-customer-id="${esc(c.id)}">
          <td class="admin-table__checkbox-col"><input type="checkbox" class="customer-select-checkbox" data-email="${email}" aria-label="Select ${email}" /></td>
          <td>${email}</td>
          <td>${esc(c.name || "—")}</td>
          <td>${esc(c.orderCount)}</td>
          <td>${esc(money(c.totalSpentCents))}</td>
          <td>${esc(new Date(c.createdAt).toLocaleDateString())}</td>
        </tr>`;
  }

  // Attaches the row-click and checkbox listeners to one already-rendered
  // <tr data-customer-row>. Shared between the full-list render and a
  // single-row patch, same reasoning as bindOrderRow above.
  function bindCustomerRow(row: HTMLTableRowElement, tbody: HTMLTableSectionElement) {
    const cb = row.querySelector<HTMLInputElement>(".customer-select-checkbox");
    if (cb) {
      cb.checked = selectedCustomerEmails.has(cb.dataset.email as string);
      cb.addEventListener("change", (e) => {
        e.stopPropagation();
        const email = cb.dataset.email as string;
        if (cb.checked) selectedCustomerEmails.add(email);
        else selectedCustomerEmails.delete(email);
        updateCustomersEmailButton();
        const all = tbody.querySelectorAll<HTMLInputElement>(".customer-select-checkbox");
        const selectAll = document.getElementById("customers-select-all") as HTMLInputElement;
        selectAll.checked = all.length > 0 && tbody.querySelectorAll(".customer-select-checkbox:checked").length === all.length;
      });
    }
    row.addEventListener("click", () => openCustomerDetail(row.dataset.customerId as string));
  }

  async function loadCustomers() {
    const tbody = document.getElementById("customers-tbody") as HTMLTableSectionElement;
    try {
      const res = await api("/api/admin/customers");
      if (!res.ok) throw new Error("Failed to load customers");
      const { customers } = (await res.json()) as { customers: CustomerSummary[] };
      customersCache.clear();
      if (customers.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">No customers yet.</td></tr>`;
        updateCustomersEmailButton();
        return;
      }
      customers.forEach((c) => customersCache.set(c.id, c));
      tbody.innerHTML = customers.map(renderCustomerRow).join("");
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-customer-row]").forEach((row) => bindCustomerRow(row, tbody));
      updateCustomersEmailButton();
    } catch {
      tbody.innerHTML = `<tr><td colspan="6" class="admin-table__empty">Couldn't load customers.</td></tr>`;
    }
  }

  // Replaces exactly the one row for the saved customer in place, instead
  // of the full loadCustomers() refetch + tbody rebuild the customer-detail
  // save flow used to trigger. orderCount/totalSpentCents come from the
  // cache (see customersCache above) since editing a customer's own details
  // never changes their order history. Falls back to a full loadCustomers()
  // if the row/cache entry can't be found.
  function patchCustomerRow(saved: { id: string; email: string; name: string | null; createdAt: string }) {
    const previous = customersCache.get(saved.id);
    if (!previous) {
      loadCustomers();
      return;
    }
    const updated: CustomerSummary = { ...previous, email: saved.email, name: saved.name, createdAt: saved.createdAt };
    customersCache.set(saved.id, updated);
    const tbody = document.getElementById("customers-tbody") as HTMLTableSectionElement;
    const existingRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-customer-row][data-customer-id="${CSS.escape(saved.id)}"]`);
    if (!existingRow) {
      loadCustomers();
      return;
    }
    existingRow.outerHTML = renderCustomerRow(updated);
    const newRow = tbody.querySelector<HTMLTableRowElement>(`tr[data-customer-row][data-customer-id="${CSS.escape(saved.id)}"]`);
    if (newRow) bindCustomerRow(newRow, tbody);
  }

  async function openCustomerDetail(id: string) {
    const detail = document.getElementById("customer-detail") as HTMLDivElement;
    const status = document.getElementById("customer-detail-status") as HTMLElement;
    status.hidden = true;
    try {
      const res = await api(`/api/admin/customers?id=${encodeURIComponent(id)}`);
      if (!res.ok) throw new Error("not found");
      const { customer } = await res.json();
      detail.hidden = false;
      (document.getElementById("cd-email") as HTMLInputElement).value = customer.email;
      (document.getElementById("cd-name") as HTMLInputElement).value = customer.name || "";
      (document.getElementById("cd-phone") as HTMLInputElement).value = customer.phone || "";

      const saveBtn = document.getElementById("customer-detail-save") as HTMLButtonElement;
      saveBtn.onclick = async () => {
        const email = (document.getElementById("cd-email") as HTMLInputElement).value.trim();
        const name = (document.getElementById("cd-name") as HTMLInputElement).value.trim();
        const phone = (document.getElementById("cd-phone") as HTMLInputElement).value.trim();
        if (!email) return showHint(status, "Email can't be blank.", false);
        saveBtn.disabled = true;
        try {
          const r = await api("/api/admin/customers", {
            method: "POST",
            body: JSON.stringify({ customerId: id, email, name: name || null, phone: phone || null }),
          });
          const data = await r.json();
          if (r.ok) {
            showHint(status, "Saved.", true);
            patchCustomerRow(data.customer);
          } else {
            showHint(status, data.error || "Failed to save.", false);
          }
        } catch {
          showHint(status, "Network error.", false);
        } finally {
          saveBtn.disabled = false;
        }
      };
    } catch {
      showGlobalError("Couldn't load that customer.");
    }
  }

