---
import PlayCanvas from "@/components/playCanvas";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Unstitch — 3D Textile Playground" showNavbar={false} showTicker={false} showFooter={false} useCustomCursor={false}>
  <div class="playground-root relative h-screen w-screen overflow-hidden flex flex-col justify-center items-center">
    <PlayCanvas client:load />
  </div>
</Layout>

<style is:global>
  /* Standard responsive cursors for 3D Playground CAD interface */
  .no-custom-cursor,
  .no-custom-cursor body,
  .no-custom-cursor .playground-root,
  .no-custom-cursor .playground-root * {
    cursor: default;
  }
  .no-custom-cursor button,
  .no-custom-cursor a,
  .no-custom-cursor [role="button"],
  .no-custom-cursor input[type="range"] {
    cursor: pointer !important;
  }
  .no-custom-cursor input[type="text"],
  .no-custom-cursor input[type="number"] {
    cursor: text !important;
  }
  .no-custom-cursor canvas {
    cursor: grab !important;
  }
  .no-custom-cursor canvas:active {
    cursor: grabbing !important;
  }
</style>
