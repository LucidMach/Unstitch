---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Next Drop Countdown | Unstitch — Limited Edition Textiles"
  description="Countdown to the next limited-edition rescued material textile drop from Unstitch studio in Melbourne."
  keywords="unstitch countdown, limited edition drop, modular textiles drop, upcycled fashion launch"
  image="/assets/floral-pattern.png"
  imageAlt="Unstitch limited edition textile drop countdown"
>
  <main>
    <!-- ============ COUNTDOWN HERO ============ -->
    <section class="media-hero countdown-hero">
      <div class="ph media-hero__media" style="background: #fbf7f9;">
        <img src="/assets/floral-pattern.png" alt="" class="w-full h-full object-cover opacity-20" />
      </div>

      <div class="media-hero__content countdown-hero__content">
        <div class="wrap text-center py-20">
          <div id="drop-announced-view" hidden>
            <p class="section__eyebrow mb-4" id="drop-announced-eyebrow">Curated Edition Drop</p>
            <h1 class="text-3xl md:text-5xl font-bold mb-8" id="drop-announced-title">Next Drop Arrives In</h1>

            <div class="countdown" data-countdown data-target="2026-09-23T18:00:00+10:00" aria-label="Time remaining until the next drop">
              <div class="countdown__unit">
                <span class="countdown__digits" data-cd-days>00</span>
                <span class="countdown__label">Days</span>
              </div>
              <span class="countdown__sep">:</span>
              <div class="countdown__unit">
                <span class="countdown__digits" data-cd-hours>00</span>
                <span class="countdown__label">Hours</span>
              </div>
              <span class="countdown__sep">:</span>
              <div class="countdown__unit">
                <span class="countdown__digits" data-cd-mins>00</span>
                <span class="countdown__label">Minutes</span>
              </div>
              <span class="countdown__sep">:</span>
              <div class="countdown__unit">
                <span class="countdown__digits" data-cd-secs>00</span>
                <span class="countdown__label">Seconds</span>
              </div>
            </div>

            <div class="countdown-actions mt-12 flex justify-center gap-4 flex-wrap">
              <button class="btn btn-filled" data-notify-toggle="#drop-notify-form">Notify Me at Launch</button>
              <a href="/shop-all" class="btn btn-outline">Preview Catalog</a>
            </div>

            <form id="drop-notify-form" class="signup__form mx-auto mt-6" style="max-width: 440px;" data-subscribe-form="countdown-notify" hidden>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none !important;" aria-hidden="true" />
              <label class="sr-only" for="notify-name">Your name</label>
              <input id="notify-name" class="signup__input" type="text" placeholder="Name" autocomplete="name" />
              <label class="sr-only" for="notify-email">Your email</label>
              <input id="notify-email" class="signup__input" type="email" placeholder="Enter email for VIP drop access" required />
              <button type="submit" class="btn btn-filled">Get Notified</button>
            </form>
          </div>

          <div id="drop-unannounced-view">
            <p class="section__eyebrow mb-4">Next Drop</p>
            <h1 class="text-3xl md:text-5xl font-bold mb-4">Nothing's counting down yet</h1>
            <p class="countdown-hero__body mx-auto mb-8">No drop is scheduled right now — Slow Bloom is the current one, live at <a href="/shop">/shop</a>. Join the list below and you'll be first to know the moment the next one is announced.</p>

            <div class="countdown-actions mt-4 flex justify-center gap-4 flex-wrap">
              <a href="/shop" class="btn btn-filled">See the Live Drop</a>
              <a href="/shop-all" class="btn btn-outline">Preview Catalog</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ EMAIL SIGNUP ============ -->
    <section class="wrap signup">
      <p class="signup__text">Every tile saves something out of the landfill. Join the movement.</p>
      <form class="signup__form" data-subscribe-form="countdown-footer-signup">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none !important;" aria-hidden="true" />
        <label class="sr-only" for="signup-name">Your name</label>
        <input id="signup-name" class="signup__input" type="text" placeholder="Name" autocomplete="name" />
        <label class="sr-only" for="signup-email">Your email</label>
        <input id="signup-email" class="signup__input" type="email" placeholder="Your Email" required />
        <button type="submit" class="btn btn-filled">Join</button>
      </form>
    </section>
  </main>
</Layout>

<style>
  .countdown-hero {
    min-height: 520px;
    background: #fbf7f9;
    border-bottom: 1px solid var(--ink);
    display: flex;
    align-items: center;
  }
  .countdown-hero__body {
    max-width: 48ch;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    color: #333;
  }
  .countdown-hero__body a {
    color: var(--ink);
    text-decoration: underline;
  }
</style>

<script>
  function initCountdown() {
    // Countdown Timer
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
      const existingTimer = (el as any)._cdTimer;
      if (existingTimer) clearInterval(existingTimer);

      const targetStr = el.dataset.target || '';
      const target = new Date(targetStr).getTime();
      const daysEl = el.querySelector<HTMLElement>('[data-cd-days]');
      const hoursEl = el.querySelector<HTMLElement>('[data-cd-hours]');
      const minsEl = el.querySelector<HTMLElement>('[data-cd-mins]');
      const secsEl = el.querySelector<HTMLElement>('[data-cd-secs]');
      const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

      let timer: ReturnType<typeof setInterval> | undefined;

      const tick = () => {
        const diff = target - Date.now();
        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '00';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
          el.classList.add('is-complete');
          if (timer !== undefined) clearInterval(timer);
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        if (daysEl) daysEl.textContent = pad(Math.floor(totalSeconds / 86400));
        if (hoursEl) hoursEl.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
        if (minsEl) minsEl.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
        if (secsEl) secsEl.textContent = pad(totalSeconds % 60);
      };

      timer = setInterval(tick, 1000);
      (el as any)._cdTimer = timer;
      tick();
    });

    // Notify toggle
    document.querySelectorAll<HTMLButtonElement>('[data-notify-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const formSelector = btn.dataset.notifyToggle;
        if (!formSelector) return;
        const form = document.querySelector<HTMLFormElement>(formSelector);
        if (!form) return;
        form.hidden = false;
        btn.hidden = true;
        form.querySelector<HTMLInputElement>('input')?.focus();
      });
    });

    // Forms
    document.querySelectorAll<HTMLFormElement>('[data-subscribe-form]').forEach((form) => {
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalLabel = submitBtn ? submitBtn.textContent : '';

      let feedback = form.nextElementSibling as HTMLElement;
      if (!feedback || !feedback.classList.contains('form-feedback')) {
        feedback = document.createElement('p');
        feedback.className = 'form-feedback';
        feedback.setAttribute('role', 'status');
        form.insertAdjacentElement('afterend', feedback);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const nameInput = form.querySelector<HTMLInputElement>('input[type="text"]:not([name="_gotcha"])');
        const gotchaInput = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
        const name = nameInput ? nameInput.value.trim() : '';
        const email = emailInput ? emailInput.value.trim() : '';
        const _gotcha = gotchaInput ? gotchaInput.value : '';

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        feedback.textContent = '';
        feedback.className = 'form-feedback';

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, source: form.dataset.subscribeForm || undefined, _gotcha }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || (res.status === 429 ? 'Too many requests. Please wait a moment.' : 'Something went wrong.'));

          form.reset();
          feedback.textContent = "You're on the list for VIP access.";
          feedback.classList.add('form-feedback--success');
        } catch (err: any) {
          feedback.textContent = err.message || 'Something went wrong. Please try again.';
          feedback.classList.add('form-feedback--error');
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
        }
      });
    });
  }

  async function initDropEvents() {
    try {
      const res = await fetch('/api/events');
      if (!res.ok) return;
      const data = await res.json();

      const announcedView = document.getElementById('drop-announced-view');
      const unannouncedView = document.getElementById('drop-unannounced-view');

      if (data.nextBatchDrop && data.nextBatchDrop.releaseAt) {
        const dropTime = new Date(data.nextBatchDrop.releaseAt).getTime();
        if (dropTime > Date.now()) {
          const cdEl = announcedView?.querySelector<HTMLElement>('[data-countdown]');
          if (cdEl) cdEl.dataset.target = data.nextBatchDrop.releaseAt;

          const titleEl = document.getElementById('drop-announced-title');
          if (titleEl && data.nextBatchDrop.productName) {
            titleEl.textContent = `${data.nextBatchDrop.productName} Arrives In`;
          }

          if (announcedView) announcedView.hidden = false;
          if (unannouncedView) unannouncedView.hidden = true;
          initCountdown();
          return;
        }
      }

      if (announcedView) announcedView.hidden = true;
      if (unannouncedView) unannouncedView.hidden = false;
    } catch {
      // Keep static view
    }
  }

  initCountdown();
  initDropEvents();
  document.addEventListener('astro:page-load', () => {
    initCountdown();
    initDropEvents();
  });
</script>
