---
interface Props {
  phrases?: string[];
}

const { phrases = ["zero waste", "modular puzzle", "upcycle textile"] } = Astro.props;
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track" data-ticker-track>
    {Array.from({ length: 6 }).map(() => (
      <>
        {phrases.map((phrase) => (
          <>
            <span>{phrase}</span>
            <span>•</span>
          </>
        ))}
      </>
    ))}
  </div>
</div>

<script>
  function initTicker() {
    const track = document.querySelector<HTMLElement>('[data-ticker-track]');
    if (!track) return;
    
    // Store original single unit if not stored
    if (!track.dataset.originalHtml) {
      const spans = track.querySelectorAll('span');
      if (spans.length > 0) {
        // Build base unit from first phrase repetition (e.g. 3 phrases + 3 bullets = 6 spans)
        const baseCount = Math.max(2, Math.floor(spans.length / 6));
        const baseSpans = Array.from(spans).slice(0, spans.length / 6 || spans.length);
        track.dataset.originalHtml = baseSpans.map(s => s.outerHTML).join('');
      } else {
        track.dataset.originalHtml = track.innerHTML;
      }
    }
    const baseHTML = track.dataset.originalHtml;
    
    const buildTicker = () => {
      if (!track || !baseHTML) return;
      
      const winWidth = window.innerWidth || document.documentElement.clientWidth || 1024;
      const needed = winWidth * 2.2;
      
      // Start with 2 base units
      track.innerHTML = baseHTML + baseHTML;
      let copies = 2;
      const MAX_COPIES = 16;
      
      let currentWidth = track.scrollWidth;
      
      // If layout hasn't resolved yet (e.g. 0 on early WebKit), default to 6 copies
      if (currentWidth <= 0) {
        for (let i = 0; i < 4; i++) {
          track.insertAdjacentHTML('beforeend', baseHTML);
        }
        copies = 6;
      } else {
        while (track.scrollWidth < needed && copies < MAX_COPIES) {
          track.insertAdjacentHTML('beforeend', baseHTML);
          copies++;
        }
        if (copies % 2 !== 0 && copies < MAX_COPIES) {
          track.insertAdjacentHTML('beforeend', baseHTML);
          copies++;
        }
      }

      const pxPerSecond = 60;
      const halfWidth = Math.max((track.scrollWidth || winWidth) / 2, 300);
      track.style.animationDuration = `${halfWidth / pxPerSecond}s`;
    };

    // Use requestAnimationFrame to ensure layout is ready
    requestAnimationFrame(buildTicker);

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(buildTicker, 200);
    }, { passive: true });
  }

  // Support both initial load and client transitions
  initTicker();
  document.addEventListener('astro:page-load', initTicker);
</script>
