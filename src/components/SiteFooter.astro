---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__nav">
      <!-- Split into three even columns instead of one flat row where
           the Shop item's five nested sub-links made it far taller than
           its single-line siblings. Learn/Custom stay commented out,
           unchanged from before. -->
      <div class="site-footer__col">
        <p class="site-footer__col-title">Explore</p>
        <ul>
          <li><a href="/playground">Play</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/learn/schools">For Schools</a></li>
          <!-- <li><a href="/learn">Learn</a></li> -->
          <!-- <li><a href="/custom">Custom</a></li> -->
          <li><a href="/archive">Material Archive</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <p class="site-footer__col-title">Shop</p>
        <ul>
          <li><a href="/order/lookup">Track Order</a></li>
          <li><a href="/passport">Product Passport</a></li>
          <li><a href="/legal#shipping">Shipping & Returns</a></li>
        </ul>
      </div>
      <div class="site-footer__col">
        <p class="site-footer__col-title">Legal &amp; Policies</p>
        <ul>
          <li><a href="/legal#privacy">Privacy Policy</a></li>
          <li><a href="/legal#terms">Terms & Conditions</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__ack-row">
      <p class="site-footer__ack">
      We acknowledge the Wurundjeri people of the Kulin Nation, the traditional custodians of this land on which we work. We pay our respects to their Elders, past and present, and recognise their creativity and connection to this unceded land.
    </p>

      <div class="site-footer__partners">
        <p class="site-footer__partners-label">Supported by</p>
        <img class="partner-monash" src="/assets/partners/monash-university-logo.svg" alt="Monash University" loading="lazy" />
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© 2025–2026 Unstitch | Naarm, Melbourne Australia</span>
      <div class="site-footer__social" aria-label="Social media">
        <a href="https://www.instagram.com/unstitchxfactory/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="#111" stroke-width="1.6"/>
            <circle cx="12" cy="12" r="4" stroke="#111" stroke-width="1.6"/>
            <circle cx="17.2" cy="6.8" r="1" fill="#111"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/unstitchx/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="3" stroke="#111" stroke-width="1.6"/>
            <path d="M7.5 10v6.2M7.5 7.3v.2M11.2 16.2V13c0-1.4.9-2.3 2-2.3s1.8.8 1.8 2.2v3.3" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  .site-footer__ack-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: 22px; }
  .site-footer__ack-row .site-footer__ack { margin-bottom: 0; }
  .site-footer__partners { display: grid; gap: 8px; justify-items: end; }
  .site-footer__partners-label { margin: 0; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: #555; }
  .site-footer__partners img { height: 36px; width: auto; filter: grayscale(100%); opacity: 0.8; transition: filter 0.2s ease, opacity 0.2s ease; }
  .site-footer__partners img:hover { filter: none; opacity: 1; }
  @media (max-width: 640px) {
    .site-footer__partners { justify-items: start; }
    .site-footer__partners img { height: 30px; }
  }
</style>
