+    // ----- Write-a-review modal -----
+    const reviewModal = document.querySelector<HTMLElement>("[data-review-modal]");
+    if (reviewModal) {
+      const openReview = () => {
+        reviewModal.hidden = false;
+        document.body.style.overflow = "hidden";
+        reviewModal.querySelector<HTMLInputElement>("input[name='passport']")?.focus();
+      };
+      const closeReview = () => {
+        reviewModal.hidden = true;
+        document.body.style.overflow = "";
+      };
+
+      document.querySelectorAll<HTMLElement>("[data-review-open]").forEach((btn) =>
+        btn.addEventListener("click", openReview),
+      );
+      reviewModal.querySelectorAll<HTMLElement>("[data-review-close]").forEach((btn) =>
+        btn.addEventListener("click", closeReview),
+      );
+      document.addEventListener("keydown", (e) => {
+        if (e.key === "Escape" && !reviewModal.hidden) closeReview();
+      });
+
+      // Star ratings — each group writes its score into a hidden input.
+      reviewModal.querySelectorAll<HTMLElement>("[data-rating-group]").forEach((group) => {
+        const hidden = group.querySelector<HTMLInputElement>("input[type='hidden']");
+        const stars = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-rating-value]"));
+        const paint = (score: number) => {
+          stars.forEach((star) => {
+            star.classList.toggle("is-active", Number(star.dataset.ratingValue) <= score);
+          });
+        };
+        stars.forEach((star) => {
+          star.addEventListener("click", () => {
+            const score = Number(star.dataset.ratingValue);
+            if (hidden) hidden.value = String(score);
+            paint(score);
+          });
+        });
+      });
+
+      const reviewForm = reviewModal.querySelector<HTMLFormElement>("[data-review-form]");
+      const reviewFeedback = reviewModal.querySelector<HTMLElement>("[data-review-feedback]");
+      reviewForm?.addEventListener("submit", (e) => {
+        e.preventDefault();
+        if (!reviewFeedback) return;
+
+        const missingRating = Array.from(
+          reviewForm.querySelectorAll<HTMLInputElement>("input[type='hidden']"),
+        ).some((input) => Number(input.value) === 0);
+
+        if (missingRating) {
+          reviewFeedback.textContent = "Please give a star rating for all three categories.";
+          reviewFeedback.className = "review-form__feedback is-error";
+          return;
+        }
+
+        // No endpoint yet: a review has to be checked against a real
+        // delivered order before it can be saved, and that API is built
+        // with checkout. Say so plainly rather than faking a success.
