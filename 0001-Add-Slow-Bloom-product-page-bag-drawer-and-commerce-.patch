+.cart-badge {
+  position: absolute;
+  top: 0;
+  right: 0;
+  min-width: 16px;
+  height: 16px;
+  padding: 0 4px;
+  border-radius: 999px;
+  background: var(--accent);
+  color: #fff;
+  font-size: 0.62rem;
+  font-weight: 700;
+  line-height: 16px;
+  text-align: center;
+}
+
+/* ==========================================================================
+   CART DRAWER (mirrors .menu-overlay / .menu-sheet — see MenuSheet)
+   ========================================================================== */
+.cart-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(17, 17, 17, 0.35);
+  z-index: 80;
+  opacity: 0;
+  pointer-events: none;
+  transition: opacity 0.2s ease;
+}
+.cart-overlay.is-open {
+  opacity: 1;
+  pointer-events: auto;
+}
+
+.cart-sheet {
+  position: fixed;
+  top: 0;
+  right: 0;
+  height: 100%;
+  width: min(420px, 88vw);
+  background: var(--paper);
+  border-left: 1px solid var(--ink);
+  z-index: 90;
+  transform: translateX(100%);
+  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
+  display: flex;
+  flex-direction: column;
+  padding: 22px 24px;
+}
+.cart-sheet.is-open { transform: translateX(0); }
+
+.cart-sheet__top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 24px;
+}
+.cart-sheet__title {
+  font-size: 1.2rem;
+}
+
+.cart-sheet__items {
+  flex: 1;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+}
+.cart-sheet__empty {
+  color: #6b6b6b;
+  font-size: 0.9rem;
+}
+
+.cart-item {
+  display: grid;
+  grid-template-columns: 72px 1fr auto;
+  gap: 12px;
+  align-items: flex-start;
+  padding-bottom: 16px;
+  border-bottom: 1px solid #eee;
+}
+.cart-item__media { min-height: 0; }
+.cart-item__name { font-weight: 600; font-size: 0.92rem; }
+.cart-item__price { color: #555; font-size: 0.85rem; margin-top: 2px; }
+.cart-item__qty {
+  margin-top: 10px;
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  border: 1px solid var(--ink);
+  border-radius: var(--radius);
+  padding: 2px 4px;
+}
+.cart-item__qty-btn {
+  background: none;
+  border: none;
+  width: 22px;
+  height: 22px;
+  font-size: 1rem;
+  line-height: 1;
+  border-radius: 4px;
+}
+.cart-item__qty-btn:hover:not(:disabled) { background: #f0f0f0; }
+.cart-item__qty-btn:disabled { opacity: 0.35; }
+.cart-item__qty-value {
+  min-width: 16px;
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+  font-size: 0.88rem;
+}
+.cart-item__remove {
+  background: none;
+  border: none;
+  font-size: 0.78rem;
+  text-decoration: underline;
+  color: #6b6b6b;
+  white-space: nowrap;
+}
+.cart-item__remove:hover { color: var(--ink); }
+
+.cart-sheet__footer {
+  border-top: 1px solid var(--ink);
+  padding-top: 16px;
+  margin-top: 12px;
+}
+.cart-sheet__subtotal {
+  display: flex;
+  justify-content: space-between;
+  font-weight: 700;
+  font-size: 1rem;
+  margin-bottom: 14px;
+}
+.cart-sheet__checkout {
+  width: 100%;
+}
+.cart-sheet__checkout:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+  transform: none;
+}
+.cart-sheet__note {
+  margin-top: 10px;
+  font-size: 0.76rem;
+  color: #6b6b6b;
+  text-align: center;
+}
+
