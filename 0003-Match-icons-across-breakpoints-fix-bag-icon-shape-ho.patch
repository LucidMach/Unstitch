+/* Add to Bag is black rather than the accent colour, per the wireframe —
+   it's the one commit-to-buy action on the page and reads as more final
+   in black; the accent stays reserved for secondary filled actions. */
+.btn-filled--black {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: #ffffff;
+}
+.btn-filled--black:hover {
+  background: #000000;
+  border-color: #000000;
+}
+
 .btn-outline {
   background: var(--paper);
   color: var(--ink);
