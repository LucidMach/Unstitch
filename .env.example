# Neon Postgres Connection String (pooled or standard for Prisma)
# Example: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection (optional, without connection pooler for Prisma migrations)
# DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL is also supported for backwards compatibility
# POSTGRES_URL="postgresql://..."

# Resend API Key for contact form notifications
RESEND_API_KEY="re_123456789"

# ---- Stripe (checkout) ----
# Publishable key — safe to expose in the browser (PUBLIC_-prefixed vars
# are exposed to frontend code by Astro).
PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_123456789"
# Secret/restricted key — server-side only. Create a restricted key scoped
# to just Checkout Sessions + Webhook Endpoints under Dashboard ->
# Developers -> API keys -> "Create restricted key".
STRIPE_SECRET_KEY="sk_test_123456789"
# Webhook signing secret — created under Dashboard -> Developers ->
# Webhooks once the endpoint exists (or via `stripe listen` for local dev).
STRIPE_WEBHOOK_SECRET="whsec_123456789"
# Optional: overrides the origin used for Checkout success/cancel URLs
# (defaults to the request's Origin header, falling back to the production
# site URL). Useful for a preview/staging deployment.
# PUBLIC_SITE_URL="https://www.unstitchx.com"

# ---- Admin panel (/admin) ----
# The single shared password used to log into /admin. Pick something long
# and random — anyone with it can edit pricing and send email as you.
ADMIN_PASSWORD="change-me-before-launch"
# Signing secret for admin session cookies AND customer order-lookup magic
# links (src/lib/signedToken.js). Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"
