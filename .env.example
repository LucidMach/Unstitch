# Neon Postgres Connection String (pooled or standard for Prisma)
# Example: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection (optional, without connection pooler for Prisma migrations)
# DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL is also supported for backwards compatibility
# POSTGRES_URL="postgresql://..."

# Resend API Key for contact form notifications
RESEND_API_KEY="re_123456789"
